        if ((b.x < (a.x - 2)) || (b.y < (a.y - 2))) {
            return false
        }
        if (((b.maxX()) > ((a.maxX()) + 2)) || ((b.maxY()) > ((a.maxY()) + 2))) {
            return false
        }
        return true
    }

