            if ((k.role != "text") && (k.role != "label")) {
                def dwh:int (this.absI((k.w - k.h)))
                def endGap:int (this.minI((k.x - n.x) ((n.maxX()) - (k.maxX()))))
                if ((dwh <= 4) && ((k.h * 10) >= (n.h * 6)) && ((this.absI(((k.cy()) - (n.cy())))) <= 4) && (endGap <= (idiv n.h 4))) {
                    return true
                }
            }
            i = (i + 1)
