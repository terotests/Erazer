        }
        return true
    }

    fn looksLikeChip:boolean (n:ErazerNode) {
        if (n.role == "backdrop") {
            return false
        }
        if ((n.role == "text") || (n.role == "label") || (n.role == "icon")) {
            return false
        }
        if ((n.role == "checkbox") || (n.role == "slider") || (n.role == "sliderthumb") || (n.role == "switch")) {
            return false
        }
        if ((n.role == "listitem") || (n.role == "list")) {
            return false
        }
        if ((n.role == "tab") || (n.role == "tablist") || (n.role == "menu") || (n.role == "menuitem")) {
            return false
        }
        if ((n.role == "form") || (n.role == "page")) {
            return false
        }
        if ((n.h < 16) || (n.h > 58)) {
            return false
        }
        if (n.w < 28) {
            return false
        }
        def aspect:double 0.0
        if (n.h > 0) {
            aspect = ((to_double n.w) / (to_double n.h))
        }
        if ((aspect < 1.05) || (aspect > 20.0)) {
