; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; Erazer.rgr — bitmap → nested EVG UI layout
; ==============================================================================
;
; Where EvgBitmapTracer follows photographic ink, Erazer looks for the things
; a screenshot of an application is made of: nested rectangles, text runs,
; form controls, and small pictorial marks. Heuristics guess a widget class
; (button, textfield, checkbox, slider, tab, menu, label, icon) and the result is an
; EVG tree that can be opened like any other document.
;
;   npm run erazer:test
;   npm run erazer -- screenshot.png out.evg.json
; ==============================================================================

Import "ErazerTypes.rgr"
Import "ErazerFont.rgr"
Import "ErazerLayout.rgr"
Import "ErazerIcons.rgr"
Import "pkg:evg/EvgBitmapTracer.rgr"
Import "pkg:evg/EVGTreeJson.rgr"
Import "pkg:image/ImageBuffer.rgr"

class Erazer {
    def img:ImageBuffer (new ImageBuffer())
    ; elements written so far: the next EVG id
    def emitCount:int 0
    def opts:ErazerOptions (new ErazerOptions())

    Constructor () {
        opts = (ErazerOptions.defaults())
        img = (new ImageBuffer())
        img.init(1 1)
    }

    sfn fromImageBuffer:ErazerDoc (img:ImageBuffer options:ErazerOptions) {
        def z (new Erazer())
        z.img = img
        z.opts = options
        return z.run()
    }

    sfn analyze:ErazerDoc (img:ImageBuffer) {
        return (Erazer.fromImageBuffer(img (ErazerOptions.defaults())))
    }

    fn absI:int (v:int) {
        if (v < 0) {
            return (0 - v)
        }
        return v
    }

    fn minI:int (a:int b:int) {
        if (a < b) {
            return a
        }
        return b
    }

    fn maxI:int (a:int b:int) {
        if (a > b) {
            return a
        }
        return b
    }

    fn lumaOf:int (r:int g:int b:int) {
        return (idiv (((r * 77) + (g * 150)) + (b * 29)) 256)
    }

    fn colorNear:boolean (r0:int g0:int b0:int r1:int g1:int b1:int tol:int) {
        if ((this.absI((r0 - r1))) > tol) {
            return false
        }
        if ((this.absI((g0 - g1))) > tol) {
            return false
        }
        if ((this.absI((b0 - b1))) > tol) {
            return false
        }
        return true
    }

    fn hexByte:string (v:int) {
        def h:string "0123456789abcdef"
        def x:int v
        if (x < 0) {
            x = 0
        }
        if (x > 255) {
            x = 255
        }
        def hi:int (idiv x 16)
        def lo:int (x - (hi * 16))
        return ((substring h hi (hi + 1)) + (substring h lo (lo + 1)))
    }

    fn hexOf:string (r:int g:int b:int) {
        return (("#" + (this.hexByte(r))) + (this.hexByte(g)) + (this.hexByte(b)))
    }

    fn tryPush:void (vis:buffer qx:[int] qy:[int] w:int h:int x:int y:int sr:int sg:int sb:int tol:int pr:int pg:int pb:int step:int) {
        if (x < 0) {
            return
        }
        if (y < 0) {
            return
        }
        if (x >= w) {
            return
        }
        if (y >= h) {
            return
        }
        def idx:int ((y * w) + x)
        if ((buffer_get vis idx) != 0) {
            return
        }
        def pixels:buffer img.pixels
        def off:int (idx * 4)
        def r:int (buffer_get pixels off)
        def g:int (buffer_get pixels (off + 1))
        def b:int (buffer_get pixels (off + 2))
        def a:int (buffer_get pixels (off + 3))
        if (a < 8) {
            buffer_set vis idx 1
            return
        }
        def take:boolean false
        if (step > 0) {
            ; Near the seed: in. Further: only by a small step from a pixel
            ; already in, on a pixel whose own 3×3 is flat. A blurred backdrop
            ; drifts that way; the anti-aliased rim of a rounded card is a
            ; chain of small steps too, but none of its pixels are flat.
            if (this.colorNear(r g b sr sg sb opts.surfaceTol)) {
                take = true
            } {
                ; A pixel beside a sharp edge is not flat, but on a smooth
                ; gradient it is within one level of where the walk came from.
                if (this.colorNear(r g b pr pg pb step) && this.colorNear(r g b sr sg sb tol) && ((this.colorNear(r g b pr pg pb 1)) || (this.flatWithin(x y w h 7)))) {
                    take = true
                }
            }
        } {
            take = (this.colorNear(r g b sr sg sb tol))
        }
        if take {
            buffer_set vis idx 1
            push qx x
            push qy y
        }
    }

    fn flood:ErazerRaw (vis:buffer w:int h:int sx:int sy:int tol:int step:int lab:[int] id:int) {
        def pixels:buffer img.pixels
        def seedOff:int ((((sy * w) + sx) * 4))
        def sr:int (buffer_get pixels seedOff)
        def sg:int (buffer_get pixels (seedOff + 1))
        def sb:int (buffer_get pixels (seedOff + 2))
        def qx:[int]
        def qy:[int]
        push qx sx
        push qy sy
        buffer_set vis ((sy * w) + sx) 1
        def head:int 0
        def minX:int sx
        def minY:int sy
        def maxX:int sx
        def maxY:int sy
        def area:int 0
        def sumR:int 0
        def sumG:int 0
        def sumB:int 0
        while (head < (array_length qx)) {
            def x:int (itemAt qx head)
            def y:int (itemAt qy head)
            head = (head + 1)
            area = (area + 1)
            set lab ((y * w) + x) id
            def off:int (((y * w) + x) * 4)
            def cr:int (buffer_get pixels off)
            def cg:int (buffer_get pixels (off + 1))
            def cb:int (buffer_get pixels (off + 2))
            sumR = (sumR + cr)
            sumG = (sumG + cg)
            sumB = (sumB + cb)
            if (x < minX) {
                minX = x
            }
            if (y < minY) {
                minY = y
            }
            if (x > maxX) {
                maxX = x
            }
            if (y > maxY) {
                maxY = y
            }
            this.tryPush(vis qx qy w h (x + 1) y sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h (x - 1) y sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h x (y + 1) sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h x (y - 1) sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h (x + 1) (y + 1) sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h (x - 1) (y + 1) sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h (x + 1) (y - 1) sr sg sb tol cr cg cb step)
            this.tryPush(vis qx qy w h (x - 1) (y - 1) sr sg sb tol cr cg cb step)
        }
        def raw (new ErazerRaw())
        raw.x = minX
        raw.y = minY
        raw.w = ((maxX - minX) + 1)
        raw.h = ((maxY - minY) + 1)
        raw.area = area
        if (area > 0) {
            raw.r = (idiv sumR area)
            raw.g = (idiv sumG area)
            raw.b = (idiv sumB area)
        }
        raw.radius = (this.cornerRad(raw))
        this.tagRaw(raw)
        return raw
    }

    fn overlapX:int (a:ErazerRaw b:ErazerRaw) {
        def left:int (this.maxI(a.x b.x))
        def right:int (this.minI((a.maxX()) (b.maxX())))
        return (right - left)
    }

    fn gapY:int (a:ErazerRaw b:ErazerRaw) {
        if ((a.maxY()) <= b.y) {
            return (b.y - (a.maxY()))
        }
        if ((b.maxY()) <= a.y) {
            return (a.y - (b.maxY()))
        }
        return 0
    }

    fn mergeRaw:void (a:ErazerRaw b:ErazerRaw) {
        def x2:int (this.minI(a.x b.x))
        def y2:int (this.minI(a.y b.y))
        def mx:int (this.maxI((a.maxX()) (b.maxX())))
        def my:int (this.maxI((a.maxY()) (b.maxY())))
        def area:int (a.area + b.area)
        def sumR:int ((a.r * a.area) + (b.r * b.area))
        def sumG:int ((a.g * a.area) + (b.g * b.area))
        def sumB:int ((a.b * a.area) + (b.b * b.area))
        a.x = x2
        a.y = y2
        a.w = (mx - x2)
        a.h = (my - y2)
        a.area = area
        if (area > 0) {
            a.r = (idiv sumR area)
            a.g = (idiv sumG area)
            a.b = (idiv sumB area)
        }
        b.used = true
        b.w = 0
    }

    ; Dots on i, umlauts, and a 5×7 cell that only touches on a diagonal
    ; arrive as two components. Join ones that share a column and sit on
    ; the same character cell.
    fn stitchGlyphs:void (raws:[ErazerRaw]) {
        def n:int (array_length raws)
        def again:boolean true
        while again {
            again = false
            def i:int 0
            while (i < n) {
                def a:ErazerRaw (itemAt raws i)
                if ((a.used == false) && (a.kind == "glyph")) {
                    def j:int 0
                    while (j < n) {
                        if (j != i) {
                            def b:ErazerRaw (itemAt raws j)
                            if ((b.used == false) && (b.w > 0)) {
                                def speck:boolean false
                                if (b.kind == "glyph") {
                                    speck = true
                                }
                                if ((b.h <= 8) && (b.w <= 12)) {
                                    speck = true
                                }
                                if (speck && ((this.overlapX(a b)) >= 1) && ((this.gapY(a b)) <= 5)) {
                                    this.mergeRaw(a b)
                                    this.tagRaw(a)
                                    again = true
                                }
                            }
                        }
                        j = (j + 1)
                    }
                }
                i = (i + 1)
            }
        }
    }

    ; A V, W, M or O at 17px is a near-square the size of a checkbox. Sitting
    ; a letter-gap from a glyph on the same baseline, it is a letter.
    fn adoptInline:void (raws:[ErazerRaw]) {
        def n:int (array_length raws)
        def again:boolean true
        def rounds:int 0
        while (again && (rounds < 8)) {
            again = false
            rounds = (rounds + 1)
            def i:int 0
            while (i < n) {
                def a:ErazerRaw (itemAt raws i)
                def cand:boolean false
                if ((a.used == false) && (a.w > 0) && ((a.kind == "box") || (a.kind == "frame") || (a.kind == "icon"))) {
                    if ((a.h >= opts.minGlyphH) && (a.h <= opts.maxGlyphH) && (a.w <= ((a.h * 2) + 8))) {
                        cand = true
                    }
                }
                if cand {
                    def j:int 0
                    while (j < n) {
                        def g:ErazerRaw (itemAt raws j)
                        if ((j != i) && (g.used == false) && (g.kind == "glyph")) {
                            def gap:int (a.x - (g.maxX()))
                            if (g.x > a.x) {
                                gap = (g.x - (a.maxX()))
                            }
                            def lim:int (this.maxI(3 (idiv a.h 3)))
                            def dh:int (this.absI((a.h - g.h)))
                            if ((gap >= 0) && (gap <= lim) && ((this.absI(((a.maxY()) - (g.maxY())))) <= 3) && (dh <= (this.maxI(4 (idiv a.h 2))))) {
                                a.kind = "glyph"
                                again = true
                                j = n
                            }
                        }
                        j = (j + 1)
                    }
                }
                i = (i + 1)
            }
        }
    }

    fn chanDist:int (r0:int g0:int b0:int r1:int g1:int b1:int) {
        def d:int (this.absI((r0 - r1)))
        def e:int (this.absI((g0 - g1)))
        def f:int (this.absI((b0 - b1)))
        if (e > d) {
            d = e
        }
        if (f > d) {
            d = f
        }
        return d
    }

    ; How far along the diagonal from one box corner the fill starts. A
    ; pixel is fill when it is nearer the fill than what the corner shows
    ; (a white card on #f2f2f7 is only 13 levels off its page, so a fixed
    ; tolerance called the page "fill" at step 0). -1: nothing to tell by.
    fn cornerInset:int (raw:ErazerRaw cx:int cy:int dx:int dy:int lim:int) {
        if (img.isValidCoord(cx cy) == false) {
            return (0 - 1)
        }
        def o:Color (img.getPixel(cx cy))
        if ((this.chanDist(o.r o.g o.b raw.r raw.g raw.b)) <= 3) {
            return 0
        }
        def k:int 1
        while (k < lim) {
            def px:int (cx + (dx * k))
            def py:int (cy + (dy * k))
            if (img.isValidCoord(px py)) {
                def c:Color (img.getPixel(px py))
                if ((this.chanDist(c.r c.g c.b raw.r raw.g raw.b)) < (this.chanDist(c.r c.g c.b o.r o.g o.b))) {
                    return k
                }
            }
            k = (k + 1)
        }
        return (0 - 1)
    }

    ; A quarter circle of radius r meets the corner's diagonal r(1 - 1/√2)
    ; in, so the radius is that inset × 3.41 (taken mid-pixel). The old value was the inset
    ; itself: a 26px iOS card came back as 8. Four corners, and the median
    ; of the ones that found the fill, so a corner something sits on does
    ; not decide it.
    fn cornerRad:int (raw:ErazerRaw) {
        def half:int (idiv (this.minI(raw.w raw.h)) 2)
        def lim:int (idiv ((half * 30) + 99) 100)
        if (lim < 1) {
            return 0
        }
        def found:[int]
        def x1:int ((raw.maxX()) - 1)
        def y1:int ((raw.maxY()) - 1)
        def c0:int (this.cornerInset(raw raw.x raw.y 1 1 (lim + 1)))
        def c1:int (this.cornerInset(raw x1 raw.y (0 - 1) 1 (lim + 1)))
        def c2:int (this.cornerInset(raw raw.x y1 1 (0 - 1) (lim + 1)))
        def c3:int (this.cornerInset(raw x1 y1 (0 - 1) (0 - 1) (lim + 1)))
        if (c0 >= 0) {
            push found c0
        }
        if (c1 >= 0) {
            push found c1
        }
        if (c2 >= 0) {
            push found c2
        }
        if (c3 >= 0) {
            push found c3
        }
        if ((array_length found) == 0) {
            return 0
        }
        def k:int (this.medianInt(found))
        if (k <= 0) {
            return 0
        }
        ; first fill pixel at k means the arc crosses somewhere in [k, k+1)
        def r:int (idiv ((((k * 2) + 1) * 341) + 100) 200)
        if (r > half) {
            r = half
        }
        return r
    }

    fn hollowAt:boolean (raw:ErazerRaw) {
        def ix:int (raw.cx())
        def iy:int (raw.cy())
        if (img.isValidCoord(ix iy) == false) {
            return false
        }
        def c:Color (img.getPixel(ix iy))
        if (this.colorNear(c.r c.g c.b raw.r raw.g raw.b 36)) {
            return false
        }
        return true
    }

    fn inkAt:int (raw:ErazerRaw x:int y:int) {
        if (img.isValidCoord(x y) == false) {
            return 0
        }
        def c:Color (img.getPixel(x y))
        if (this.colorNear(c.r c.g c.b raw.r raw.g raw.b 36)) {
            return 1
        }
        return 0
    }

    ; A drawn rectangle outline: ink along all four edges, not only at their
    ; middles (an O or a 0 has those too), and nothing in the middle.
    fn ringLike:boolean (raw:ErazerRaw) {
        if ((raw.w < 10) || (raw.h < 10)) {
            return false
        }
        ; An outlined button on a dark card has a fill a few steps from its
        ; border, so the middle is compared tightly.
        def mc:Color (img.getPixel((raw.cx()) (raw.cy())))
        if (this.colorNear(mc.r mc.g mc.b raw.r raw.g raw.b 6)) {
            return false
        }
        def x0:int raw.x
        def y0:int raw.y
        def x1:int ((raw.maxX()) - 1)
        def y1:int ((raw.maxY()) - 1)
        def qx:int (idiv raw.w 4)
        def qy:int (idiv raw.h 4)
        def hits:int 0
        hits = (hits + (this.inkAt(raw (x0 + qx) y0)))
        hits = (hits + (this.inkAt(raw (raw.cx()) y0)))
        hits = (hits + (this.inkAt(raw (x1 - qx) y0)))
        hits = (hits + (this.inkAt(raw (x0 + qx) y1)))
        hits = (hits + (this.inkAt(raw (raw.cx()) y1)))
        hits = (hits + (this.inkAt(raw (x1 - qx) y1)))
        hits = (hits + (this.inkAt(raw x0 (y0 + qy))))
        hits = (hits + (this.inkAt(raw x0 (raw.cy()))))
        hits = (hits + (this.inkAt(raw x0 (y1 - qy))))
        hits = (hits + (this.inkAt(raw x1 (y0 + qy))))
        hits = (hits + (this.inkAt(raw x1 (raw.cy()))))
        hits = (hits + (this.inkAt(raw x1 (y1 - qy))))
        return (hits >= 11)
    }

    fn tagRaw:void (raw:ErazerRaw) {
        def fr:double (raw.fillRatio())
        if ((raw.h <= 3) && (raw.w >= 16)) {
            raw.kind = "line"
            return
        }
        if ((raw.w <= 3) && (raw.h >= 16)) {
            raw.kind = "line"
            return
        }
        if (((raw.fillRatio()) < 0.55) && (this.ringLike(raw))) {
            raw.kind = "frame"
            return
        }
        ; Letters whose fringes touch arrive as one word-shaped blob.
        if ((raw.parts >= 3) && (raw.h >= opts.minGlyphH) && (raw.h <= opts.maxGlyphH) && (raw.w > (idiv (raw.h * 3) 2)) && (fr < 0.92)) {
            raw.kind = "glyph"
            return
        }
        def glyph:boolean true
        if (raw.h < opts.minGlyphH) {
            glyph = false
        }
        if (raw.h > opts.maxGlyphH) {
            glyph = false
        }
        if (raw.w > ((raw.h * 2) + 8)) {
            glyph = false
        }
        if ((raw.nearSquare()) && (raw.w >= 12)) {
            glyph = false
        }
        if ((fr > 0.86) && (raw.w >= 10) && ((this.absI((raw.w - raw.h))) <= 4)) {
            glyph = false
        }
        ; A solid pill or block (a switch track, a badge) is not a letter,
        ; nor is one flat surface of that size with a knob cut out of it.
        if ((fr >= 0.7) && (raw.area >= 200)) {
            glyph = false
        }
        if (raw.surface && (raw.parts == 1) && (raw.area >= 400)) {
            glyph = false
        }
        if glyph {
            raw.kind = "glyph"
            return
        }
        def hole:boolean (this.hollowAt(raw))
        if ((raw.nearSquare()) && (raw.w >= opts.iconMin) && (raw.w <= opts.iconMax) && (fr < 0.75) && (hole == false)) {
            raw.kind = "icon"
            return
        }
        if ((fr < 0.55) && (raw.w >= 10) && (raw.h >= 10) && hole) {
            raw.kind = "frame"
            return
        }
        raw.kind = "box"
    }

    ; The 3×3 around (x, y) is one colour: the seed sits inside a surface,
    ; not on anti-aliased ink or an edge.
    fn flatAt:boolean (x:int y:int w:int h:int) {
        return (this.flatWithin(x y w h 2))
    }

    fn flatWithin:boolean (x:int y:int w:int h:int tol:int) {
        def pixels:buffer img.pixels
        def off:int (((y * w) + x) * 4)
        def r:int (buffer_get pixels off)
        def g:int (buffer_get pixels (off + 1))
        def b:int (buffer_get pixels (off + 2))
        def dy:int (0 - 1)
        while (dy <= 1) {
            def dx:int (0 - 1)
            while (dx <= 1) {
                def px:int (x + dx)
                def py:int (y + dy)
                if ((px >= 0) && (py >= 0) && (px < w) && (py < h)) {
                    def o:int (((py * w) + px) * 4)
                    if (this.colorNear(r g b (buffer_get pixels o) (buffer_get pixels (o + 1)) (buffer_get pixels (o + 2)) tol) == false) {
                        return false
                    }
                }
                dx = (dx + 1)
            }
            dy = (dy + 1)
        }
        return true
    }

    fn findRoot:int (par:[int] k:int) {
        def c:int k
        while ((itemAt par c) != c) {
            def up:int (itemAt par c)
            set par c (itemAt par up)
            c = (itemAt par c)
        }
        return c
    }

    fn fragJoin:void (par:[int] frag:[int] lab:[int] a:int idx:int) {
        def b:int (itemAt lab idx)
        if ((b < 0) || (b == a)) {
            return
        }
        if ((itemAt frag b) == 0) {
            return
        }
        def ra:int (this.findRoot(par a))
        def rb:int (this.findRoot(par b))
        if (ra != rb) {
            set par rb ra
        }
    }

    ; Small components that touch are one mark. A 17px anti-aliased letter
    ; is a dark core, grey fringes, a few 1–4px specks and a counter hole;
    ; left apart they became a dozen 5×1 "panels" around every word.
    fn mergeFragments:void (all:[ErazerRaw] lab:[int] w:int h:int) {
        def m:int (array_length all)
        def frag:[int]
        def par:[int]
        def lim:int (opts.maxGlyphH + 4)
        def k:int 0
        while (k < m) {
            def r:ErazerRaw (itemAt all k)
            def f:int 0
            if ((r.h <= lim) && (r.kind != "line")) {
                if ((r.area <= opts.fragArea) && (r.w <= lim)) {
                    f = 1
                }
                ; The light halo round a word: not a surface, sparse, as wide
                ; as the word.
                if ((r.surface == false) && ((r.fillRatio()) < 0.5) && (r.kind != "frame")) {
                    f = 1
                }
            }
            push frag f
            push par k
            k = (k + 1)
        }
        def y:int 0
        while (y < h) {
            def x:int 0
            while (x < w) {
                def idx:int ((y * w) + x)
                def a:int (itemAt lab idx)
                if (a >= 0) {
                    if ((itemAt frag a) == 1) {
                        if ((x + 1) < w) {
                            this.fragJoin(par frag lab a (idx + 1))
                        }
                        if ((y + 1) < h) {
                            this.fragJoin(par frag lab a (idx + w))
                            if ((x + 1) < w) {
                                this.fragJoin(par frag lab a ((idx + w) + 1))
                            }
                            if (x > 0) {
                                this.fragJoin(par frag lab a ((idx + w) - 1))
                            }
                        }
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        def touched:[int]
        def t0:int 0
        while (t0 < m) {
            push touched 0
            t0 = (t0 + 1)
        }
        def j:int 0
        while (j < m) {
            def root:int (this.findRoot(par j))
            if (root != j) {
                def into:ErazerRaw (itemAt all root)
                def gone:ErazerRaw (itemAt all j)
                def x2:int (this.minI(into.x gone.x))
                def y2:int (this.minI(into.y gone.y))
                def mx:int (this.maxI((into.maxX()) (gone.maxX())))
                def my:int (this.maxI((into.maxY()) (gone.maxY())))
                into.x = x2
                into.y = y2
                into.w = (mx - x2)
                into.h = (my - y2)
                into.area = (into.area + gone.area)
                into.parts = (into.parts + gone.parts)
                set touched root 1
            }
            j = (j + 1)
        }
        ; The mark takes the colour of the piece that stands out most from
        ; what is beside it: the ink core, not the grey fringe or the
        ; background showing through a counter.
        def bgL:[int]
        def best:[int]
        def c0:int 0
        while (c0 < m) {
            def rc:ErazerRaw (itemAt all c0)
            def bl:int (0 - 1)
            if ((itemAt touched c0) == 1) {
                def bx:int (rc.x - 1)
                if (bx < 0) {
                    bx = (rc.maxX())
                }
                def by:int (rc.cy())
                if (img.isValidCoord(bx by)) {
                    def bc:Color (img.getPixel(bx by))
                    bl = (this.lumaOf(bc.r bc.g bc.b))
                }
            }
            push bgL bl
            push best (0 - 1)
            c0 = (c0 + 1)
        }
        def j2:int 0
        while (j2 < m) {
            def root2:int (this.findRoot(par j2))
            if ((itemAt touched root2) == 1) {
                def piece:ErazerRaw (itemAt all j2)
                def bl2:int (itemAt bgL root2)
                if ((bl2 >= 0) && (piece.area >= 3)) {
                    def con:int (this.absI(((this.lumaOf(piece.r piece.g piece.b)) - bl2)))
                    if (con > (itemAt best root2)) {
                        set best root2 con
                        def into2:ErazerRaw (itemAt all root2)
                        into2.r = piece.r
                        into2.g = piece.g
                        into2.b = piece.b
                    }
                }
            }
            j2 = (j2 + 1)
        }
        def j3:int 0
        while (j3 < m) {
            if ((this.findRoot(par j3)) != j3) {
                def gone3:ErazerRaw (itemAt all j3)
                gone3.used = true
                gone3.w = 0
            }
            j3 = (j3 + 1)
        }
        def q:int 0
        while (q < m) {
            if ((itemAt touched q) == 1) {
                def raw:ErazerRaw (itemAt all q)
                raw.radius = (this.cornerRad(raw))
                this.tagRaw(raw)
            }
            q = (q + 1)
        }
    }

    ; Mean colour of the first and last quarter of a big surface, across
    ; and down. When the ends differ enough the surface is a two-stop
    ; gradient (a blurred backdrop, a tinted card); the quarter means sit at
    ; 1/8 and 7/8, so the stops are pushed out to the box's edges.
    fn measureGradients:void (all:[ErazerRaw] lab:[int] w:int h:int) {
        def m:int (array_length all)
        def slot:[int]
        def big:int 0
        def i:int 0
        while (i < m) {
            def r:ErazerRaw (itemAt all i)
            if (r.surface && (r.used == false) && (r.area >= 4000) && (r.w >= 40) && (r.h >= 40)) {
                push slot big
                big = (big + 1)
            } {
                push slot (0 - 1)
            }
            i = (i + 1)
        }
        if (big == 0) {
            return
        }
        ; per slot: top, bottom, left, right × (r, g, b, n)
        def acc:[int]
        def z:int 0
        while (z < (big * 16)) {
            push acc 0
            z = (z + 1)
        }
        def pixels:buffer img.pixels
        def y:int 0
        while (y < h) {
            def x:int 0
            while (x < w) {
                def idx:int ((y * w) + x)
                def id:int (itemAt lab idx)
                if (id >= 0) {
                    def sl:int (itemAt slot id)
                    if (sl >= 0) {
                        def r2:ErazerRaw (itemAt all id)
                        def off:int (idx * 4)
                        def base:int (sl * 16)
                        def qh:int (idiv r2.h 4)
                        def qw:int (idiv r2.w 4)
                        if (y < (r2.y + qh)) {
                            this.addAcc(acc base pixels off)
                        }
                        if (y >= ((r2.maxY()) - qh)) {
                            this.addAcc(acc (base + 4) pixels off)
                        }
                        if (x < (r2.x + qw)) {
                            this.addAcc(acc (base + 8) pixels off)
                        }
                        if (x >= ((r2.maxX()) - qw)) {
                            this.addAcc(acc (base + 12) pixels off)
                        }
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        def j:int 0
        while (j < m) {
            def sl2:int (itemAt slot j)
            if (sl2 >= 0) {
                def r3:ErazerRaw (itemAt all j)
                def base2:int (sl2 * 16)
                def dv:int (this.accSpread(acc base2 (base2 + 4)))
                def dh:int (this.accSpread(acc (base2 + 8) (base2 + 12)))
                def from:int base2
                def to:int (base2 + 4)
                def dir:int 0
                def spread:int dv
                if (dh > dv) {
                    from = (base2 + 8)
                    to = (base2 + 12)
                    dir = 1
                    spread = dh
                }
                if (spread >= 10) {
                    r3.gradDir = dir
                    r3.gFromR = (this.stopOut(acc from to 0))
                    r3.gFromG = (this.stopOut(acc from to 1))
                    r3.gFromB = (this.stopOut(acc from to 2))
                    r3.gToR = (this.stopOut(acc to from 0))
                    r3.gToG = (this.stopOut(acc to from 1))
                    r3.gToB = (this.stopOut(acc to from 2))
                }
            }
            j = (j + 1)
        }
    }

    fn addAcc:void (acc:[int] at:int pixels:buffer off:int) {
        set acc at ((itemAt acc at) + (buffer_get pixels off))
        set acc (at + 1) ((itemAt acc (at + 1)) + (buffer_get pixels (off + 1)))
        set acc (at + 2) ((itemAt acc (at + 2)) + (buffer_get pixels (off + 2)))
        set acc (at + 3) ((itemAt acc (at + 3)) + 1)
    }

    fn accMean:int (acc:[int] at:int ch:int) {
        def n:int (itemAt acc (at + 3))
        if (n <= 0) {
            return 0
        }
        return (idiv (itemAt acc (at + ch)) n)
    }

    ; Largest channel difference between two quarter means; 0 when either
    ; quarter is empty (a surface cut through by cards).
    fn accSpread:int (acc:[int] a:int b:int) {
        if (((itemAt acc (a + 3)) < 50) || ((itemAt acc (b + 3)) < 50)) {
            return 0
        }
        def d:int 0
        def ch:int 0
        while (ch < 3) {
            def v:int (this.absI(((this.accMean(acc a ch)) - (this.accMean(acc b ch)))))
            if (v > d) {
                d = v
            }
            ch = (ch + 1)
        }
        return d
    }

    ; near + (near - far) / 6: from the 1/8 mark out to the edge.
    fn stopOut:int (acc:[int] near:int far:int ch:int) {
        def a:int (this.accMean(acc near ch))
        def b:int (this.accMean(acc far ch))
        def v:int (a + (idiv (a - b) 6))
        if (v < 0) {
            return 0
        }
        if (v > 255) {
            return 255
        }
        return v
    }

    fn components:[ErazerRaw] () {
        def w:int img.width
        def h:int img.height
        def n:int (w * h)
        def vis:buffer (buffer_alloc n)
        buffer_fill vis 0 0 n
        def lab:[int]
        def z:int 0
        while (z < n) {
            push lab (0 - 1)
            z = (z + 1)
        }
        def all:[ErazerRaw]
        ; Surfaces first, each grown from a flat seed with the tight
        ; tolerance; then whatever is left (ink, edges, gradients) with the
        ; loose one.
        def i:int 0
        while (i < n) {
            if ((buffer_get vis i) == 0) {
                def y:int (idiv i w)
                def x:int (i - (y * w))
                if (this.flatAt(x y w h)) {
                    def sraw:ErazerRaw (this.flood(vis w h x y opts.surfaceDrift opts.surfaceStep lab (array_length all)))
                    sraw.surface = true
                    this.tagRaw(sraw)
                    push all sraw
                }
            }
            i = (i + 1)
        }
        def i2:int 0
        while (i2 < n) {
            if ((buffer_get vis i2) == 0) {
                def y2:int (idiv i2 w)
                def x2:int (i2 - (y2 * w))
                push all (this.flood(vis w h x2 y2 opts.colorTol 0 lab (array_length all)))
            }
            i2 = (i2 + 1)
        }
        this.mergeFragments(all lab w h)
        this.measureGradients(all lab w h)
        def out:[ErazerRaw]
        def o:int 0
        while (o < (array_length all)) {
            def raw:ErazerRaw (itemAt all o)
            if ((raw.used == false) && (raw.area >= opts.minArea)) {
                push out raw
            }
            o = (o + 1)
        }
        return out
    }

    fn sortRawByYX:void (arr:[ErazerRaw]) {
        def n:int (array_length arr)
        def i:int 1
        while (i < n) {
            def j:int i
            def keep:boolean true
            while ((j > 0) && keep) {
                def a:ErazerRaw (itemAt arr j)
                def b:ErazerRaw (itemAt arr (j - 1))
                def swap:boolean false
                if (a.y < (b.y - 2)) {
                    swap = true
                } {
                    if ((this.absI((a.y - b.y))) <= 2) {
                        if (a.x < b.x) {
                            swap = true
                        }
                    }
                }
                if swap {
                    set arr (j - 1) a
                    set arr j b
                    j = (j - 1)
                } {
                    keep = false
                }
            }
            i = (i + 1)
        }
    }

    fn sortRawByX:void (arr:[ErazerRaw]) {
        def n:int (array_length arr)
        def i:int 1
        while (i < n) {
            def j:int i
            def keep:boolean true
            while ((j > 0) && keep) {
                def a:ErazerRaw (itemAt arr j)
                def b:ErazerRaw (itemAt arr (j - 1))
                if (a.x < b.x) {
                    set arr (j - 1) a
                    set arr j b
                    j = (j - 1)
                } {
                    keep = false
                }
            }
            i = (i + 1)
        }
    }

    fn sortNodesByAreaAsc:void (arr:[ErazerNode]) {
        def n:int (array_length arr)
        def i:int 1
        while (i < n) {
            def j:int i
            def keep:boolean true
            while ((j > 0) && keep) {
                def a:ErazerNode (itemAt arr j)
                def b:ErazerNode (itemAt arr (j - 1))
                def aa:int (a.w * a.h)
                def bb:int (b.w * b.h)
                if (aa < bb) {
                    set arr (j - 1) a
                    set arr j b
                    j = (j - 1)
                } {
                    keep = false
                }
            }
            i = (i + 1)
        }
    }

    ; Glyphs arrive sorted by top edge, so an ascender (l, d) comes before
    ; the x-height letters between it and the seed. Sweep until nothing
    ; joins, so the gap is always measured from the run's current end.
    fn lineOf:[ErazerRaw] (glyphs:[ErazerRaw] start:int) {
        def members:[ErazerRaw]
        def seed:ErazerRaw (itemAt glyphs start)
        push members seed
        seed.used = true
        def base:int (seed.maxY())
        def hh:int seed.h
        def left:int seed.x
        def right:int (seed.maxX())
        def n:int (array_length glyphs)
        def grew:boolean true
        while grew {
            grew = false
            def j:int (start + 1)
            while (j < n) {
                def g:ErazerRaw (itemAt glyphs j)
                if (g.used == false) {
                    def dy:int (this.absI(((g.maxY()) - base)))
                    def dh:int (this.absI((g.h - hh)))
                    def gap:int (g.x - right)
                    if ((g.maxX()) <= left) {
                        gap = (left - (g.maxX()))
                    }
                    if ((g.x < right) && ((g.maxX()) > left)) {
                        gap = 0
                    }
                    ; a word space, not the gap to the next button
                    def maxGap:int (hh + 6)
                    if ((dy <= 5) && (dh <= (this.maxI(5 (idiv hh 2)))) && (gap <= maxGap)) {
                        push members g
                        g.used = true
                        grew = true
                        if ((g.maxX()) > right) {
                            right = (g.maxX())
                        }
                        if (g.x < left) {
                            left = g.x
                        }
                        if (g.h > hh) {
                            hh = g.h
                        }
                        def nb:int (g.maxY())
                        if (nb > base) {
                            base = nb
                        }
                    }
                }
                j = (j + 1)
            }
        }
        return members
    }

    fn textFromGlyphs:ErazerNode (members:[ErazerRaw]) {
        this.sortRawByX(members)
        def n:int (array_length members)
        def g0:ErazerRaw (itemAt members 0)
        def minX:int g0.x
        def minY:int g0.y
        def maxX:int (g0.maxX())
        def maxY:int (g0.maxY())
        def sumH:int 0
        def sumR:int 0
        def sumG:int 0
        def sumB:int 0
        def i:int 0
        while (i < n) {
            def g:ErazerRaw (itemAt members i)
            if (g.x < minX) {
                minX = g.x
            }
            if (g.y < minY) {
                minY = g.y
            }
            if ((g.maxX()) > maxX) {
                maxX = (g.maxX())
            }
            if ((g.maxY()) > maxY) {
                maxY = (g.maxY())
            }
            sumH = (sumH + g.h)
            sumR = (sumR + g.r)
            sumG = (sumG + g.g)
            sumB = (sumB + g.b)
            i = (i + 1)
        }
        def node:ErazerNode (ErazerNode.of("text" minX minY (maxX - minX) (maxY - minY) 0 0 0))
        node.fontSize = (idiv sumH n)
        node.textR = (idiv sumR n)
        node.textG = (idiv sumG n)
        node.textB = (idiv sumB n)
        node.r = node.textR
        node.g = node.textG
        node.b = node.textB
        node.confidence = 0.7
        def text:string ""
        if opts.ocr {
            def lineH:int (maxY - minY)
            text = (this.ocrLine(minX minY maxX maxY lineH node.textR node.textG node.textB))
        }
        node.text = text
        return node
    }

    fn ocrLine:string (minX:int minY:int maxX:int maxY:int lineH:int inkR:int inkG:int inkB:int) {
        def cell:int (idiv lineH 7)
        if (cell < 1) {
            cell = 1
        }
        def step:int (cell * 6)
        def win:int (cell * 5)
        def text:string ""
        def x:int minX
        def guard:int 0
        def distSum:int 0
        def read:int 0
        while ((x + (cell * 3)) <= (maxX + cell)) {
            def bits:string (ErazerFont.sampleBits(img x minY win lineH minY lineH inkR inkG inkB))
            def ch:string (ErazerFont.matchBits(bits))
            if ((strlen ch) == 0) {
                x = (x + cell)
            } {
                if (ch == " ") {
                    x = (x + cell)
                } {
                    text = (text + ch)
                    distSum = (distSum + (ErazerFont.matchDist(bits)))
                    read = (read + 1)
                    x = (x + step)
                }
            }
            guard = (guard + 1)
            if (guard > 80) {
                x = (maxX + cell)
            }
        }
        ; The atlas face reads back at 0–2 mismatches a cell. A proportional
        ; anti-aliased font averages far more and spells noise
        ; ("hKMM55MMJ"); keep the run, drop the reading.
        if ((read > 0) && ((distSum * 10) > (read * 25))) {
            return ""
        }
        if ((this.wordChars(text) * 2) < (strlen text)) {
            return ""
        }
        return text
    }

    fn wordChars:int (s:string) {
        def keep:string "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        def c:int 0
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if ((indexOf keep ch) >= 0) {
                c = (c + 1)
            }
            i = (i + 1)
        }
        return c
    }

    fn clusterText:[ErazerNode] (raws:[ErazerRaw]) {
        def glyphs:[ErazerRaw]
        def i:int 0
        while (i < (array_length raws)) {
            def r:ErazerRaw (itemAt raws i)
            if ((r.used == false) && (r.kind == "glyph")) {
                push glyphs r
            }
            i = (i + 1)
        }
        this.sortRawByYX(glyphs)
        def out:[ErazerNode]
        def j:int 0
        while (j < (array_length glyphs)) {
            def g:ErazerRaw (itemAt glyphs j)
            if (g.used == false) {
                def members:[ErazerRaw] (this.lineOf(glyphs j))
                def skipTiny:boolean false
                if ((array_length members) == 1) {
                    def only:ErazerRaw (itemAt members 0)
                    if ((only.w <= 5) && (only.h <= 12)) {
                        skipTiny = true
                    }
                }
                if (skipTiny == false) {
                    push out (this.textFromGlyphs(members))
                }
            }
            j = (j + 1)
        }
        this.mergeTextRuns(out)
        def live:[ErazerNode]
        def k:int 0
        while (k < (array_length out)) {
            def n:ErazerNode (itemAt out k)
            if (n.w > 0) {
                push live n
            }
            k = (k + 1)
        }
        return live
    }

    fn mergeTextRuns:void (texts:[ErazerNode]) {
        def n:int (array_length texts)
        def again:boolean true
        while again {
            again = false
            def i:int 0
            while (i < n) {
                def a:ErazerNode (itemAt texts i)
                if (a.w > 0) {
                    def j:int 0
                    while (j < n) {
                        if (j != i) {
                            def b:ErazerNode (itemAt texts j)
                            if (b.w > 0) {
                                def dy:int (this.absI(((a.maxY()) - (b.maxY()))))
                                def gap:int (b.x - (a.maxX()))
                                ; A word space, not the gap between two buttons.
                                def maxGap:int ((this.maxI(a.h b.h)) + 6)
                                if ((dy <= 5) && (gap >= (0 - 8)) && (gap <= maxGap) && ((this.absI((a.y - b.y))) <= 8)) {
                                    def left:ErazerNode a
                                    def right:ErazerNode b
                                    if (b.x < a.x) {
                                        left = b
                                        right = a
                                    }
                                    def sp:string ""
                                    def realGap:int (right.x - (left.maxX()))
                                    if (realGap > (idiv (left.h * 2) 3)) {
                                        sp = " "
                                    }
                                    left.text = ((left.text + sp) + right.text)
                                    def x2:int (this.minI(left.x right.x))
                                    def y2:int (this.minI(left.y right.y))
                                    def mx:int (this.maxI((left.x + left.w) (right.x + right.w)))
                                    def my:int (this.maxI((left.y + left.h) (right.y + right.h)))
                                    left.x = x2
                                    left.y = y2
                                    left.w = (mx - x2)
                                    left.h = (my - y2)
                                    if (right.fontSize > left.fontSize) {
                                        left.fontSize = right.fontSize
                                    }
                                    right.w = 0
                                    again = true
                                }
                            }
                        }
                        j = (j + 1)
                    }
                }
                i = (i + 1)
            }
        }
    }

    fn fullBleed:boolean (raw:ErazerRaw w:int h:int) {
        if (raw.x > 1) {
            return false
        }
        if (raw.y > 1) {
            return false
        }
        if ((raw.maxX()) < (w - 1)) {
            return false
        }
        if ((raw.maxY()) < (h - 1)) {
            return false
        }
        return true
    }

    ; The anti-aliased corner of a rounded surface is its own thin arc.
    ; Sitting in a corner of a bigger box, it is that box's edge, not an icon.
    fn dropCornerSlivers:void (raws:[ErazerRaw]) {
        def n:int (array_length raws)
        def i:int 0
        while (i < n) {
            def a:ErazerRaw (itemAt raws i)
            def small:boolean ((a.w <= 10) && (a.h <= 10))
            if ((a.used == false) && (a.kind != "line") && (((a.fillRatio()) < 0.5) || small)) {
                def j:int 0
                while (j < n) {
                    def p:ErazerRaw (itemAt raws j)
                    if ((j != i) && (p.w > 0) && (p.kind != "glyph") && ((p.w * p.h) > ((a.w * a.h) * 4))) {
                        ; the corner outside the arc can reach a pixel past the box
                        if ((a.x >= (p.x - 2)) && (a.y >= (p.y - 2)) && ((a.maxX()) <= ((p.maxX()) + 2)) && ((a.maxY()) <= ((p.maxY()) + 2))) {
                            def atX:boolean (((this.absI((a.x - p.x))) <= 2) || ((this.absI(((p.maxX()) - (a.maxX())))) <= 2))
                            def atY:boolean (((this.absI((a.y - p.y))) <= 2) || ((this.absI(((p.maxY()) - (a.maxY())))) <= 2))
                            def half:int ((idiv (this.minI(p.w p.h)) 2) + 2)
                            if (atX && atY && (a.w <= half) && (a.h <= half)) {
                                a.used = true
                                j = n
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
    }

    fn overlapArea:int (a:ErazerNode b:ErazerNode) {
        def x0:int (this.maxI(a.x b.x))
        def y0:int (this.maxI(a.y b.y))
        def x1:int (this.minI((a.maxX()) (b.maxX())))
        def y1:int (this.minI((a.maxY()) (b.maxY())))
        if ((x1 <= x0) || (y1 <= y0)) {
            return 0
        }
        return ((x1 - x0) * (y1 - y0))
    }

    ; Two layers. The page's own surface is rarely one region: cards, their
    ; shadows and a blurred backdrop cut it into pieces whose boxes run
    ; across the cards on top of them (a sliver down the right edge, the
    ; strip between two cards). When two region boxes cross (neither holds
    ; the other), the one holding fewer other regions is backdrop (a card
    ; holds its rows and labels, a sliver of blur holds nothing); on a tie
    ; the sparser one. Backdrop is taken
    ; out of nesting, so nothing is parented to it, and goes under the rest.
    fn splitBackdrop:[ErazerNode] (nodes:[ErazerNode] page:ErazerNode) {
        def under:[ErazerNode]
        def n:int (array_length nodes)
        def flag:[int]
        def z:int 0
        while (z < n) {
            push flag 0
            z = (z + 1)
        }
        def i:int 0
        while (i < n) {
            def a:ErazerNode (itemAt nodes i)
            def big:boolean ((a.w * a.h) >= 2000)
            if ((a.w > 0) && big && (this.isContainer(a)) && (a.role != "listitem")) {
                def j:int 0
                while (j < n) {
                    def b:ErazerNode (itemAt nodes j)
                    if ((j != i) && (b.w > 0) && (this.isContainer(b)) && ((b.w * b.h) >= 400)) {
                        def ov:int (this.overlapArea(a b))
                        def small:int (this.minI((a.w * a.h) (b.w * b.h)))
                        if (((ov * 10) > small) && ((this.coversLoosely(a b)) == false) && ((this.coversLoosely(b a)) == false)) {
