        }
        return true
    }

    fn similarFill:boolean (a:ErazerNode b:ErazerNode) {
        if ((this.absI((a.r - b.r))) > 40) {
            return false
        }
        if ((this.absI((a.g - b.g))) > 40) {
            return false
        }
        if ((this.absI((a.b - b.b))) > 40) {
            return false
        }
        return true
    }

    fn similarChipRow:boolean (a:ErazerNode b:ErazerNode) {
        if ((this.absI((a.y - b.y))) > 8) {
            return false
        }
        if ((this.absI((a.h - b.h))) > 8) {
            return false
        }
        if (this.similarFill(a b) == false) {
            return false
        }
        return true
    }

    ; A pill about twice as wide as tall with a round knob at one end.
    fn looksLikeSwitch:boolean (n:ErazerNode) {
        if ((n.h < 14) || (n.h > 44)) {
            return false
        }
        def aspect:double ((to_double n.w) / (to_double n.h))
        if ((aspect < 1.4) || (aspect > 2.4)) {
            return false
