    fn guessSelf:void (n:ErazerNode) {
        if (n.role == "text") {
            return
        }
        if (n.role == "icon") {
            return
        }
        if ((n.role == "page") || (n.role == "listitem") || (n.role == "backdrop") || (n.role == "underlay")) {
            return
        }
        def texts:int (this.textKidCount(n))
        if (this.looksLikeSwitch(n)) {
            n.role = "switch"
            n.confidence = 0.8
            return
        }
        def oneLine:boolean (this.oneLineText(n))
        def sq:boolean false
        def dwh:int (this.absI((n.w - n.h)))
        if ((dwh <= 4) && (n.w >= 10) && (n.w <= 32)) {
            sq = true
        }
        if (sq && (texts == 0)) {
            n.role = "checkbox"
            n.confidence = 0.82
            return
        }
        def aspect:double 0.0
        if (n.h > 0) {
            aspect = ((to_double n.w) / (to_double n.h))
        }
        if ((n.h >= 4) && (n.h <= 20) && (n.w >= 80) && (texts == 0) && (aspect >= 6.0)) {
            n.role = "slider"
            n.confidence = 0.8
            return
        }
        def lum:int (this.lumaOf(n.r n.g n.b))
        def centered:boolean false
        def leftish:boolean true
        def hit@(optional):ErazerNode (this.firstText(n))
        if hit {
            def t:ErazerNode (unwrap hit)
            def dx:int (this.absI(((t.cx()) - (n.cx()))))
            def dy:int (this.absI(((t.cy()) - (n.cy()))))
            if ((dx <= (idiv n.w 3)) && (dy <= (idiv n.h 2))) {
                centered = true
            }
            if ((t.x - n.x) > (idiv n.w 5)) {
                if ((t.x - n.x) > 10) {
                    leftish = false
                }
            }
            if ((t.x - n.x) > n.h) {
                leftish = false
            }
        }
        if ((n.h >= 16) && (n.h <= 58) && (n.w >= 28) && (n.w <= 360) && (aspect >= 1.12) && (aspect <= 9.0)) {
            if (oneLine && centered) {
                n.role = "button"
                n.confidence = 0.8
                if hit {
                    this.copyTextOnto(n (unwrap hit))
                }
                return
            }
        }
        if ((n.h >= 18) && (n.h <= 58) && (n.w >= 72) && (aspect >= 2.4)) {
            if ((lum >= 200) || (n.borderW > 0)) {
                if ((texts <= 1) || oneLine) {
                    if ((leftish && (centered == false)) || (texts == 0)) {
                        n.role = "textfield"
                        n.confidence = 0.78
                        if hit {
                            this.copyTextOnto(n (unwrap hit))
                        }
                        return
                    }
                }
            }
        }
        if ((n.h >= 16) && (n.h <= 58) && (n.w >= 28) && (n.w <= 360) && (aspect >= 1.12) && (aspect <= 9.0)) {
            if oneLine {
                n.role = "button"
                n.confidence = 0.6
                if hit {
                    this.copyTextOnto(n (unwrap hit))
                }
                return
            }
        }
        ; Compact chips stay unclassified here so a sibling row can still
        ; promote them; tall boxes with several children are panels.
        if (((array_length n.kids) >= 2) && (n.w > 48) && (n.h > 58)) {
            n.role = "panel"
            n.confidence = 0.55
            return
        }
    }

    fn classifyTree:void (n:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            this.classifyTree(k)
            i = (i + 1)
        }
        this.guessSelf(n)
        if ((n.role == "text") && ((array_length n.kids) == 0)) {
            ; a lone run sitting in a panel is a label
        }
    }

    fn collectFonts:void (n:ErazerNode out:[int]) {
        if (((n.role == "text") || (n.role == "label")) && (n.fontSize > 0)) {
            push out n.fontSize
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            this.collectFonts(k out)
            i = (i + 1)
        }
    }

    fn medianFont:int (root:ErazerNode) {
        def fs:[int]
        this.collectFonts(root fs)
        return (this.medianInt(fs))
    }

    fn lumaAt:int (x:int y:int) {
        if (img.isValidCoord(x y) == false) {
            return (0 - 1)
        }
        def c:Color (img.getPixel(x y))
        return (this.lumaOf(c.r c.g c.b))
    }

    ; Median luma of four points two pixels outside the run's box.
    fn localBgLuma:int (t:ErazerNode) {
        def ls:[int]
        def a:int (this.lumaAt((t.x - 2) (t.cy())))
        def b:int (this.lumaAt(((t.maxX()) + 1) (t.cy())))
        def c:int (this.lumaAt((t.cx()) (t.y - 2)))
        def d:int (this.lumaAt((t.cx()) ((t.maxY()) + 1)))
        if (a >= 0) {
            push ls a
        }
        if (b >= 0) {
            push ls b
        }
        if (c >= 0) {
            push ls c
        }
        if (d >= 0) {
            push ls d
        }
        if ((array_length ls) == 0) {
            return (0 - 1)
        }
        return (this.medianInt(ls))
    }

    ; Why a run is not text, given where it sits and what it looks like.
    ; "" when it may be text.
    fn textDoubt:string (t:ErazerNode par:ErazerNode med:int) {
        ; the shadow crescent in a switch, the tick in a checkbox
        if ((par.role == "switch") || (par.role == "checkbox") || (par.role == "slider") || (par.role == "sliderthumb") || (par.role == "icon")) {
            return "control"
        }
        ; one tall mark far bigger than the page's text: a D-shaped shadow
        ; at 34px among 14px labels
        if ((med > 0) && ((t.fontSize * 10) > (med * 18)) && ((t.w * 10) < (t.h * 7))) {
            return "size"
        }
        ; ink barely off what is right around it (not the parent's mean
        ; fill, which a text block drags toward its ink)
        def lt:int (this.lumaOf(t.textR t.textG t.textB))
        def bg:int (this.localBgLuma(t))
        if ((bg >= 0) && ((this.absI((lt - bg))) < 24)) {
            return "contrast"
        }
        return ""
    }

    ; Runs that cannot be text: inside a control they are part of its
    ; look and go; elsewhere they stay as a "shape" (geometry and colour,
    ; no text, no font).
    fn dropImplausibleText:void (n:ErazerNode med:int) {
        def keep:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            def drop:boolean false
            if ((k.role == "text") || (k.role == "label")) {
                def why:string (this.textDoubt(k n med))
                if (why == "control") {
                    drop = true
                }
                if ((why == "size") || (why == "contrast")) {
                    k.role = "shape"
                    k.r = k.textR
                    k.g = k.textG
                    k.b = k.textB
                    k.text = ""
                    k.fontSize = 0
                    k.confidence = 0.5
                }
            }
            if (drop == false) {
                push keep k
                this.dropImplausibleText(k med)
            }
            i = (i + 1)
        }
        n.kids = keep
        ; a control that took its text from a run that is gone
        if ((n.role != "text") && (n.role != "label") && ((strlen n.text) > 0) && ((this.textKidCount(n)) == 0)) {
            n.text = ""
            n.fontSize = 0
        }
    }

    fn relabelTexts:void (n:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (k.role == "text") {
                if ((n.role == "panel") || (n.role == "page") || (n.role == "form") || (n.role == "menu") || (n.role == "listitem") || (n.role == "list")) {
                    k.role = "label"
                }
            }
            this.relabelTexts(k)
            i = (i + 1)
        }
    }

    fn promoteGroups:void (n:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            this.promoteGroups(k)
            i = (i + 1)
        }
        this.promoteSliders(n)
        this.promoteRows(n)
        def fields:int 0
        def c:int 0
        while (c < (array_length n.kids)) {
            def k2:ErazerNode (itemAt n.kids c)
            if (k2.role == "textfield") {
                fields = (fields + 1)
            }
            c = (c + 1)
        }
        if ((fields >= 2) && ((n.role == "panel") || (n.role == "page"))) {
            n.role = "form"
            n.confidence = 0.84
        }
        this.promoteButtons(n)
        this.promoteTabs(n)
        this.promoteMenu(n)
    }

    fn rowCandidate:boolean (k:ErazerNode) {
        if (k.role == "backdrop") {
            return false
        }
        if ((k.role == "text") || (k.role == "label") || (k.role == "icon") || (k.role == "checkbox") || (k.role == "switch")) {
            return false
        }
        if ((k.role == "slider") || (k.role == "sliderthumb")) {
            return false
        }
        if ((k.h < 20) || (k.w < (k.h * 3))) {
            return false
        }
        return true
    }

    ; Full-width bands stacked edge to edge (a hairline or nothing between
    ; them) are list rows, whatever a single band looked like on its own.
    fn promoteRows:void (n:ErazerNode) {
        def cand:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (this.rowCandidate(k)) {
                push cand k
            }
            i = (i + 1)
        }
        def m:int (array_length cand)
        if (m < 2) {
            return
        }
        this.sortNodesByY(cand)
        ; Follow each chain by the band that starts where this one ends,
        ; skipping anything else in between (a stray backdrop region).
        def taken:[int]
        def z:int 0
        while (z < m) {
            push taken 0
            z = (z + 1)
        }
        def rows:int 0
        def a:int 0
        while (a < m) {
            if ((itemAt taken a) == 0) {
                def chain:[int]
                push chain a
                def cur:int a
                def go:boolean true
                while go {
                    go = false
                    def p:ErazerNode (itemAt cand cur)
                    def q:int (cur + 1)
                    while (q < m) {
                        def c:ErazerNode (itemAt cand q)
                        def gap:int (c.y - (p.maxY()))
                        if (((itemAt taken q) == 0) && (gap >= (0 - 1)) && (gap <= 3) && ((this.absI((p.x - c.x))) <= 3) && ((this.absI((p.w - c.w))) <= 6)) {
                            push chain q
                            cur = q
                            go = true
                            q = m
                        }
                        q = (q + 1)
                    }
                }
                if ((array_length chain) >= 2) {
                    def t:int 0
                    while (t < (array_length chain)) {
                        def ti:int (itemAt chain t)
                        set taken ti 1
                        def r:ErazerNode (itemAt cand ti)
                        r.role = "listitem"
                        r.confidence = 0.72
                        t = (t + 1)
                    }
                    rows = (rows + (array_length chain))
                }
            }
            a = (a + 1)
        }
        if ((rows >= 2) && (n.role != "page")) {
            n.role = "list"
            n.confidence = 0.72
        }
    }

    fn sortNodesByY:void (arr:[ErazerNode]) {
        def n:int (array_length arr)
        def i:int 1
        while (i < n) {
            def j:int i
            def keep:boolean true
            while ((j > 0) && keep) {
                def a:ErazerNode (itemAt arr j)
                def b:ErazerNode (itemAt arr (j - 1))
                if (a.y < b.y) {
                    set arr (j - 1) a
                    set arr j b
                    j = (j - 1)
                } {
                    keep = false
                }
            }
            i = (i + 1)
        }
    }

    fn absorbNode:void (keep:ErazerNode gone:ErazerNode) {
        def x2:int (this.minI(keep.x gone.x))
        def y2:int (this.minI(keep.y gone.y))
        def mx:int (this.maxI((keep.maxX()) (gone.maxX())))
        def my:int (this.maxI((keep.maxY()) (gone.maxY())))
        keep.x = x2
        keep.y = y2
        keep.w = (mx - x2)
        keep.h = (my - y2)
        gone.w = 0
    }

    fn pruneZero:void (n:ErazerNode) {
        def live:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (k.w > 0) {
                push live k
            }
            i = (i + 1)
        }
        n.kids = live
    }

    fn collinearTracks:boolean (a:ErazerNode b:ErazerNode) {
        ; Centre lines, not top edges: the filled half can carry the thumb
        ; in its own region and stand taller than the empty half.
        if ((this.absI(((a.cy()) - (b.cy())))) > 4) {
            return false
        }
        if ((this.absI((a.h - b.h))) > 12) {
            return false
        }
        def gap:int 0
        if ((a.maxX()) < b.x) {
            gap = (b.x - (a.maxX()))
        } {
            if ((b.maxX()) < a.x) {
                gap = (a.x - (b.maxX()))
            } {
                gap = 0
            }
        }
        ; A circular thumb often sits in the gap between the filled and
        ; empty halves of a range track.
        if (gap > 32) {
            return false
        }
        return true
    }

    fn looksLikeThumb:boolean (n:ErazerNode track:ErazerNode) {
        if (n.w <= 0) {
            return false
        }
        if (n.role == "slider") {
            return false
        }
        def dwh:int (this.absI((n.w - n.h)))
        if ((dwh > 6) || (n.w < 8) || (n.w > 32) || (n.h < 8)) {
            return false
        }
        if ((this.absI(((n.cy()) - (track.cy())))) > ((this.maxI(track.h n.h)) + 4)) {
            return false
        }
        def slack:int (idiv n.w 2)
        if ((n.cx()) < (track.x - slack)) {
            return false
        }
        if ((n.cx()) > ((track.maxX()) + slack)) {
            return false
        }
        return true
    }

    fn promoteSliders:void (n:ErazerNode) {
        def tracks:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (this.looksLikeTrack(k)) {
                push tracks k
            }
            i = (i + 1)
        }
        def merged:[int]
        def z:int 0
        while (z < (array_length tracks)) {
            push merged 0
            z = (z + 1)
        }
        def a:int 0
        while (a < (array_length tracks)) {
            def left:ErazerNode (itemAt tracks a)
            if (left.w > 0) {
                def b:int (a + 1)
                while (b < (array_length tracks)) {
                    def right:ErazerNode (itemAt tracks b)
                    if (right.w > 0) {
                        if (this.collinearTracks(left right)) {
                            this.absorbNode(left right)
                            set merged a 1
                        }
                    }
                    b = (b + 1)
                }
            }
            a = (a + 1)
        }
        ; A lone thin bar (a home indicator, a divider, a progress stripe)
        ; is not a slider: a range control has a thumb on the bar or a
        ; filled part beside an empty one.
        def t:int 0
        while (t < (array_length tracks)) {
            def tr:ErazerNode (itemAt tracks t)
            if (tr.w > 0) {
                def hh:int (this.maxI(1 tr.h))
                def aspect:double ((to_double tr.w) / (to_double hh))
                def thumbs:int 0
                def tk:int 0
                while (tk < (array_length tr.kids)) {
                    def own:ErazerNode (itemAt tr.kids tk)
                    if (this.looksLikeThumb(own tr)) {
                        thumbs = (thumbs + 1)
                    }
                    tk = (tk + 1)
                }
                def c:int 0
                while (c < (array_length n.kids)) {
                    def thumb:ErazerNode (itemAt n.kids c)
                    if ((thumb != tr) && (this.looksLikeThumb(thumb tr))) {
                        thumbs = (thumbs + 1)
                    }
                    c = (c + 1)
                }
                def twoTone:boolean ((itemAt merged t) > 0)
                if ((tr.w >= 80) && (aspect >= 6.0) && ((thumbs > 0) || twoTone)) {
                    tr.role = "slider"
                    tr.confidence = 0.82
                    def tk2:int 0
                    while (tk2 < (array_length tr.kids)) {
                        def own2:ErazerNode (itemAt tr.kids tk2)
                        if (this.looksLikeThumb(own2 tr)) {
                            own2.role = "sliderthumb"
                            own2.confidence = 0.8
                        }
                        tk2 = (tk2 + 1)
                    }
                    def c2:int 0
                    while (c2 < (array_length n.kids)) {
                        def thumb2:ErazerNode (itemAt n.kids c2)
                        if ((thumb2 != tr) && (this.looksLikeThumb(thumb2 tr))) {
                            thumb2.role = "sliderthumb"
                            thumb2.confidence = 0.8
                        }
                        c2 = (c2 + 1)
                    }
                } {
                    if (tr.role == "slider") {
                        tr.role = "panel"
                        tr.confidence = 0.4
                    }
                }
            }
            t = (t + 1)
        }
        this.pruneZero(n)
    }

    fn applyButtonRow:void (group:[ErazerNode]) {
        def lined:int 0
        def already:int 0
        def i:int 0
        while (i < (array_length group)) {
            def k:ErazerNode (itemAt group i)
            if (k.role == "button") {
                already = (already + 1)
            }
            if (this.oneLineText(k)) {
                lined = (lined + 1)
            }
            i = (i + 1)
        }
        def ok:boolean false
        if (lined >= 2) {
            ok = true
        }
        if ((already >= 1) && ((array_length group) >= 2)) {
            ok = true
        }
        if (ok == false) {
            return
        }
        def t:int 0
        while (t < (array_length group)) {
            def k2:ErazerNode (itemAt group t)
            if (k2.role != "button") {
                k2.role = "button"
                k2.confidence = 0.74
                def hit@(optional):ErazerNode (this.firstText(k2))
                if hit {
                    this.copyTextOnto(k2 (unwrap hit))
                }
            }
            t = (t + 1)
        }
    }

    fn promoteButtons:void (n:ErazerNode) {
        def cand:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (this.looksLikeChip(k)) {
                push cand k
            }
            i = (i + 1)
        }
        if ((array_length cand) < 2) {
            return
        }
        def flags:[int]
        def f:int 0
        while (f < (array_length cand)) {
            push flags 0
            f = (f + 1)
        }
        def a:int 0
        while (a < (array_length cand)) {
            def marked:int (itemAt flags a)
            if (marked == 0) {
                def seed:ErazerNode (itemAt cand a)
                def group:[ErazerNode]
                push group seed
                set flags a 1
                def b:int 0
                while (b < (array_length cand)) {
                    def om:int (itemAt flags b)
                    if (om == 0) {
                        def other:ErazerNode (itemAt cand b)
                        if (this.similarChipRow(seed other)) {
                            push group other
                            set flags b 1
                        }
                    }
                    b = (b + 1)
                }
                if ((array_length group) >= 2) {
                    this.applyButtonRow(group)
                }
            }
            a = (a + 1)
        }
    }

    fn promoteTabs:void (n:ErazerNode) {
        def cand:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (((strlen k.text) > 0) && (k.h >= 20)) {
                if ((k.role == "button") || (k.role == "panel") || (k.role == "tab") || (k.role == "textfield")) {
                    push cand k
                }
            }
            i = (i + 1)
        }
        if ((array_length cand) < 3) {
            return
        }
        def a:ErazerNode (itemAt cand 0)
        def same:int 1
        def j:int 1
        while (j < (array_length cand)) {
            def b:ErazerNode (itemAt cand j)
            if ((this.absI((a.y - b.y))) <= 6) {
                if ((this.absI((a.h - b.h))) <= 8) {
                    same = (same + 1)
                }
            }
            j = (j + 1)
        }
        if (same >= 3) {
            def minW:int a.w
            def maxW:int a.w
            def wj:int 0
            while (wj < (array_length cand)) {
                def cw:ErazerNode (itemAt cand wj)
                if ((this.absI((a.y - cw.y))) <= 6) {
                    if (cw.w < minW) {
                        minW = cw.w
                    }
                    if (cw.w > maxW) {
                        maxW = cw.w
                    }
                }
                wj = (wj + 1)
            }
            ; Unequal-width chips on a form (Rest / Sick / a long label) are
            ; buttons, not a tab strip. Equal File/Edit/View bars still match.
            if (maxW > ((idiv (minW * 3) 2) + 24)) {
                return
            }
            def t:int 0
            while (t < (array_length cand)) {
                def k3:ErazerNode (itemAt cand t)
                k3.role = "tab"
                k3.confidence = 0.75
                t = (t + 1)
            }
            if (((array_length cand) == (array_length n.kids)) && (n.role != "page")) {
                n.role = "tablist"
            }
        }
    }

    fn promoteMenu:void (n:ErazerNode) {
        def cand:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (((strlen k.text) > 0) && (k.h >= 20)) {
                if ((k.role == "button") || (k.role == "panel") || (k.role == "menuitem") || (k.role == "textfield")) {
                    push cand k
                }
            }
            i = (i + 1)
        }
        if ((array_length cand) < 3) {
            return
        }
        def a:ErazerNode (itemAt cand 0)
        def same:int 1
        def j:int 1
        while (j < (array_length cand)) {
            def b:ErazerNode (itemAt cand j)
            if ((this.absI((a.x - b.x))) <= 8) {
                if ((this.absI((a.w - b.w))) <= 16) {
                    if ((this.absI((a.h - b.h))) <= 10) {
                        same = (same + 1)
                    }
                }
            }
            j = (j + 1)
        }
        if (same >= 3) {
            def t:int 0
            while (t < (array_length cand)) {
                def k3:ErazerNode (itemAt cand t)
                k3.role = "menuitem"
                k3.confidence = 0.72
                t = (t + 1)
            }
            if (n.role != "page") {
                n.role = "menu"
                n.confidence = 0.72
            }
        }
    }

    ; Each pixel of b by its projection onto background → ink, where the
    ; background is the mean of the one-pixel ring just outside the box:
    ; ink black, background white.
    fn inkToBlack:void (b:ImageBuffer x:int y:int w:int h:int ir:int ig:int ib:int) {
        def sr:int 0
        def sg:int 0
        def sb:int 0
        def cnt:int 0
        def px:int (x - 1)
        while (px <= (x + w)) {
            def e:int 0
            while (e < 2) {
                def py:int (y - 1)
                if (e == 1) {
                    py = (y + h)
                }
                if (img.isValidCoord(px py)) {
                    def c:Color (img.getPixel(px py))
                    sr = (sr + c.r)
                    sg = (sg + c.g)
                    sb = (sb + c.b)
                    cnt = (cnt + 1)
                }
                e = (e + 1)
            }
            px = (px + 1)
        }
        def qy:int y
        while (qy < (y + h)) {
            def f:int 0
            while (f < 2) {
                def qx:int (x - 1)
                if (f == 1) {
                    qx = (x + w)
                }
                if (img.isValidCoord(qx qy)) {
                    def c2:Color (img.getPixel(qx qy))
                    sr = (sr + c2.r)
                    sg = (sg + c2.g)
                    sb = (sb + c2.b)
                    cnt = (cnt + 1)
                }
                f = (f + 1)
            }
            qy = (qy + 1)
        }
        if (cnt == 0) {
            return
        }
        def br:int (idiv sr cnt)
        def bgc:int (idiv sg cnt)
        def bb:int (idiv sb cnt)
        def dr:int (ir - br)
        def dg:int (ig - bgc)
        def db:int (ib - bb)
        def dd:int (((dr * dr) + (dg * dg)) + (db * db))
        ; ink and background too alike to tell apart: trace as it is
        if (dd < 400) {
            return
        }
        def yy:int 0
        while (yy < b.height) {
            def xx:int 0
            while (xx < b.width) {
                def c3:Color (b.getPixel(xx yy))
                def dot:int ((((c3.r - br) * dr) + ((c3.g - bgc) * dg)) + ((c3.b - bb) * db))
                def t:int (idiv (dot * 255) dd)
                if (t < 0) {
                    t = 0
                }
                if (t > 255) {
                    t = 255
                }
                def v:int (255 - t)
                b.setPixelRGBA(xx yy v v v 255)
                xx = (xx + 1)
            }
            yy = (yy + 1)
        }
    }

    fn crop:ImageBuffer (x:int y:int w:int h:int) {
        def out (new ImageBuffer())
        def cw:int (this.maxI(1 w))
        def ch:int (this.maxI(1 h))
        out.init(cw ch)
        def py:int 0
        while (py < ch) {
            def px:int 0
            while (px < cw) {
                def sx:int (x + px)
                def sy:int (y + py)
                if (img.isValidCoord(sx sy)) {
                    def c:Color (img.getPixel(sx sy))
                    out.setPixelRGBA(px py c.r c.g c.b c.a)
                }
                px = (px + 1)
            }
            py = (py + 1)
        }
        return out
    }

    fn traceIcons:void (n:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            this.traceIcons(k)
            i = (i + 1)
        }
        if (n.role == "icon") {
            if opts.vectorizeIcons {
                def pad:int 1
                def cx:int (this.maxI(0 (n.x - pad)))
                def cy:int (this.maxI(0 (n.y - pad)))
                def cw:int (n.w + (pad * 2))
                def ch:int (n.h + (pad * 2))
                def slice:ImageBuffer (this.crop(cx cy cw ch))
                ; the tracer follows dark pixels: the crop becomes black where
                ; it is the icon's ink and white where it is the background
                ; around it, so a white icon on an orange button is traced as
                ; the icon and not as its surroundings (a box)
                this.inkToBlack(slice n.x n.y n.w n.h n.r n.g n.b)
                def topts:EvgTraceOptions (EvgTraceOptions.preset("lineart"))
                topts.turdsize = 1
                def tr:EvgBitmapTracer (EvgBitmapTracer.fromImageBuffer(slice topts))
                tr.trace()
                n.iconVw = cw
                n.iconVh = ch
                n.iconSvg = (tr.toSVG())
                def els:[EVGElement] (tr.toEVGElements())
                def e:int 0
                while (e < (array_length els)) {
                    def el:EVGElement (itemAt els e)
                    push n.iconPaths el.svgPath
                    push n.iconFills (el.fillColor.toHexString())
                    e = (e + 1)
                }
            }
        }
    }

    fn emitNode:EVGElement (n:ErazerNode px:int py:int) {
        emitCount = 0
        return (this.emitIn(n px py (0 - 1) 0 0))
    }

    ; parent fill passed down: a row the colour of its card is structure,
    ; not paint, and a square fill on it would cover the card's corners.
    fn emitIn:EVGElement (n:ErazerNode px:int py:int pr:int pg:int pb:int) {
        def el:EVGElement (EVGElement.createDiv())
        if ((n.role == "text") || (n.role == "label")) {
            el = (EVGElement.createSpan())
            el.textContent = n.text
            if (n.fontSize > 0) {
                el.fontSize = (EVGUnit.px((to_double n.fontSize)))
            }
            el.color = (EVGColor.rgb(n.textR n.textG n.textB))
        } {
            def sameAsParent:boolean ((pr >= 0) && (n.gradDir < 0) && (this.colorNear(n.r n.g n.b pr pg pb 3)) && (n.role != "icon"))
            ; a traced icon is its paths: a box in its ink colour under them
            ; drew every icon as a solid block
            def traced:boolean ((n.role == "icon") && ((array_length n.iconPaths) > 0))
            if ((sameAsParent == false) && (traced == false)) {
                el.backgroundColor = (EVGColor.rgb(n.r n.g n.b))
            }
            if (n.gradDir >= 0) {
                el.gradientSet = true
                el.gradientFrom = (EVGColor.rgb(n.gFromR n.gFromG n.gFromB))
                el.gradientTo = (EVGColor.rgb(n.gToR n.gToG n.gToB))
                el.gradientDir = n.gradDir
            }
            if ((n.role == "button") || (n.role == "textfield") || (n.role == "tab") || (n.role == "menuitem") || (n.role == "slider")) {
                if ((strlen n.text) > 0) {
                    ; text also lives on a child span
                }
            }
            if ((n.radius > 0) && (traced == false)) {
                el.box.borderRadius = (EVGUnit.px((to_double n.radius)))
            }
            if ((n.borderW > 0) && (traced == false)) {
                el.box.borderWidth = (EVGUnit.px((to_double n.borderW)))
                el.box.borderColor = (EVGColor.rgb(n.borderR n.borderG n.borderB))
            }
        }
        if ((strlen n.align) > 0) {
            el.textAlign = n.align
        }
        emitCount = (emitCount + 1)
        n.uid = ("n" + (to_string emitCount))
        el.id = n.uid
        el.className = ("erazer-" + n.role)
        if ((strlen n.iconName) > 0) {
            el.className = ((el.className + " erazer-icon-") + n.iconName)
        }
        el.position = "absolute"
        el.left = (EVGUnit.px((to_double (n.x - px))))
        el.top = (EVGUnit.px((to_double (n.y - py))))
        el.width = (EVGUnit.px((to_double n.w)))
        el.height = (EVGUnit.px((to_double n.h)))
        def p:int 0
        while (p < (array_length n.iconPaths)) {
            def pathEl:EVGElement (EVGElement.createPath())
            pathEl.svgPath = (itemAt n.iconPaths p)
            pathEl.fillRule = "evenodd"
            ; the tracer fills its paths black; the icon's ink is n's colour
            pathEl.fillColor = (EVGColor.rgb(n.r n.g n.b))
            def vw:int n.w
            def vh:int n.h
            def off:int 0
            if (n.iconVw > 0) {
                ; traced from a crop one pixel wider on every side
                vw = n.iconVw
                vh = n.iconVh
                off = (idiv (vw - n.w) 2)
            }
            pathEl.viewBox = (("0 0 " + (to_string vw)) + " " + (to_string vh))
            pathEl.width = (EVGUnit.px((to_double vw)))
            pathEl.height = (EVGUnit.px((to_double vh)))
            pathEl.position = "absolute"
            pathEl.left = (EVGUnit.px((to_double (0 - off))))
            pathEl.top = (EVGUnit.px((to_double (0 - off))))
            el.addChild(pathEl)
            p = (p + 1)
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if ((n.role == "text") || (n.role == "label")) {
                el.addChild(this.emitIn(k n.x n.y (0 - 1) 0 0))
            } {
                el.addChild(this.emitIn(k n.x n.y n.r n.g n.b))
            }
            i = (i + 1)
        }
        return el
    }

    fn writeOutline:string (n:ErazerNode pad:string) {
        def line:string (((((pad + n.role) + " ") + (to_string n.x)) + "," + (to_string n.y)))
        line = (((((line + " ") + (to_string n.w)) + "x") + (to_string n.h)))
        line = ((line + " ") + (this.hexOf(n.r n.g n.b)))
        if ((strlen n.text) > 0) {
            line = ((((line + " \"") + n.text) + "\""))
        }
        if (n.fontSize > 0) {
            line = ((line + " font=") + (to_string n.fontSize))
        }
        if ((n.role == "text") || (n.role == "label") || (n.role == "button") || (n.role == "tab") || (n.role == "menuitem") || (n.role == "slider")) {
            if (n.fontSize > 0) {
                line = ((line + " ink=") + (this.hexOf(n.textR n.textG n.textB)))
            }
        }
        if ((strlen n.iconSvg) > 0) {
            line = (line + " icon=svg")
        }
        if ((strlen n.iconName) > 0) {
            line = ((((line + " name=") + n.iconName) + " ") + (to_string (floor (n.iconConf * 100.0)))) + "%")
        }
        if (((strlen n.align) > 0) && (n.align != "left")) {
            line = ((line + " align=") + n.align)
        }
        if (n.radius > 0) {
            line = ((line + " r=") + (to_string n.radius))
        }
        if (n.gradDir >= 0) {
            def axis:string "v"
            if (n.gradDir == 1) {
                axis = "h"
            }
            line = ((((((line + " grad=") + axis) + " ") + (this.hexOf(n.gFromR n.gFromG n.gFromB))) + ">") + (this.hexOf(n.gToR n.gToG n.gToB)))
        }
        def out:string (line + "\n")
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            out = (out + (this.writeOutline(k (pad + "  "))))
            i = (i + 1)
        }
        return out
    }

    fn roleStroke:string (role:string) {
        if (role == "button") {
            return "#2563eb"
        }
        if (role == "textfield") {
            return "#0f766e"
        }
        if (role == "checkbox") {
            return "#7c3aed"
        }
        if (role == "label") {
            return "#b45309"
        }
        if (role == "text") {
            return "#b45309"
        }
        if (role == "tab") {
            return "#db2777"
        }
        if (role == "tablist") {
            return "#be185d"
        }
        if (role == "menu") {
            return "#0369a1"
        }
        if (role == "menuitem") {
            return "#0284c7"
        }
        if (role == "form") {
            return "#15803d"
        }
        if (role == "icon") {
            return "#ea580c"
        }
        if (role == "slider") {
            return "#4f46e5"
        }
        if (role == "sliderthumb") {
            return "#6366f1"
        }
        if (role == "switch") {
            return "#16a34a"
        }
        if ((role == "backdrop") || (role == "underlay")) {
            return "#cbd5e1"
        }
        if (role == "shape") {
            return "#94a3b8"
        }
        if (role == "listitem") {
            return "#0891b2"
        }
        if (role == "list") {
            return "#0e7490"
        }
        return "#64748b"
    }

    fn writeOverlay:string (n:ErazerNode w:int h:int groups:[ErazerLayoutGuess]) {
        def svg:string "<svg xmlns=\"http://www.w3.org/2000/svg\" "
        svg = (svg + "width=\"" + (to_string w) + "\" height=\"" + (to_string h) + "\" ")
        svg = (svg + "viewBox=\"0 0 " + (to_string w) + " " + (to_string h) + "\">")
        svg = (svg + (this.overlayNode(n)))
        svg = (svg + (this.overlayGroups(groups)))
        svg = (svg + "</svg>")
        return svg
    }

    fn overlayGroups:string (groups:[ErazerLayoutGuess]) {
        def s:string ""
        def i:int 0
        while (i < (array_length groups)) {
            def g:ErazerLayoutGuess (itemAt groups i)
            s = (s + "<g data-layout=\"" + g.type + "\">")
            s = (s + "<rect x=\"" + (to_string g.x) + "\" y=\"" + (to_string g.y) + "\" ")
            s = (s + "width=\"" + (to_string g.w) + "\" height=\"" + (to_string g.h) + "\" ")
            s = (s + "fill=\"none\" stroke=\"#7c3aed\" stroke-width=\"2\" stroke-dasharray=\"5 3\" pointer-events=\"none\"/>")
            def lab:string (g.type + " " + (to_string g.confidence))
            s = (s + "<text x=\"" + (to_string (g.x + 4.0)) + "\" y=\"" + (to_string (g.y + 12.0)) + "\" ")
            s = (s + "font-size=\"10\" fill=\"#7c3aed\" pointer-events=\"none\">" + (this.xmlEsc(lab)) + "</text>")
            s = (s + "</g>")
            i = (i + 1)
        }
        return s
    }

    fn xmlEsc:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:string (substring s i (i + 1))
            if (ch == "<") {
                out = (out + "&lt;")
            } {
                if (ch == ">") {
                    out = (out + "&gt;")
                } {
                    if (ch == "\"") {
                        out = (out + "&quot;")
                    } {
                        if (ch == "&") {
                            out = (out + "&amp;")
                        } {
                            out = (out + ch)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    fn overlayNode:string (n:ErazerNode) {
        def col:string (this.roleStroke(n.role))
        def s:string "<g>"
        s = (s + "<rect x=\"" + (to_string n.x) + "\" y=\"" + (to_string n.y) + "\" ")
        s = (s + "width=\"" + (to_string n.w) + "\" height=\"" + (to_string n.h) + "\" ")
        if ((strlen n.uid) > 0) {
            s = (s + "data-node=\"" + n.uid + "\" ")
        }
        if (n.boxId > 0) {
            s = (s + "data-box=\"" + (to_string (n.boxId - 1)) + "\" ")
            s = (s + "fill=\"transparent\" ")
        } {
            s = (s + "fill=\"none\" ")
        }
        if ((n.role == "backdrop") || (n.role == "underlay")) {
            s = (s + "stroke=\"" + col + "\" stroke-width=\"1\" stroke-dasharray=\"2 4\"/>")
        } {
            s = (s + "stroke=\"" + col + "\" stroke-width=\"1\"/>")
        }
        def lab:string n.role
        if ((strlen n.iconName) > 0) {
            lab = ((lab + " ") + n.iconName)
        }
        if ((strlen n.text) > 0) {
            lab = ((lab + " ") + n.text)
        }
        s = (s + "<text x=\"" + (to_string (n.x + 2)) + "\" y=\"" + (to_string (n.y + 10)) + "\" ")
        s = (s + "font-size=\"9\" fill=\"" + col + "\">" + (this.xmlEsc(lab)) + "</text>")
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            s = (s + (this.overlayNode(k)))
            i = (i + 1)
        }
        s = (s + "</g>")
        return s
    }

    fn pickScale:int () {
        if (opts.scale > 0) {
            return opts.scale
        }
        def w:int img.width
        def h:int img.height
        if ((w > 900) && ((h * 10) >= (w * 16))) {
            def k:int (idiv (w + 195) 390)
            if (k < 1) {
                return 1
            }
            return k
        }
        return 1
    }

    ; k×k box average: a 1px hairline at 3x stays a faint line instead of
    ; falling between bilinear samples.
    fn boxDown:ImageBuffer (k:int) {
        def sw:int img.width
        def nw:int (idiv sw k)
        def nh:int (idiv img.height k)
        def out (new ImageBuffer())
        out.init(nw nh)
        def src:buffer img.pixels
        def kk:int (k * k)
        def y:int 0
        while (y < nh) {
            def x:int 0
            while (x < nw) {
                def sr:int 0
                def sg:int 0
                def sb:int 0
                def sa:int 0
                def dy:int 0
                while (dy < k) {
                    def row:int ((y * k) + dy)
                    def dx:int 0
                    while (dx < k) {
                        def off:int (((row * sw) + ((x * k) + dx)) * 4)
                        sr = (sr + (buffer_get src off))
                        sg = (sg + (buffer_get src (off + 1)))
                        sb = (sb + (buffer_get src (off + 2)))
                        sa = (sa + (buffer_get src (off + 3)))
                        dx = (dx + 1)
                    }
                    dy = (dy + 1)
                }
                out.setPixelRGBA(x y (idiv sr kk) (idiv sg kk) (idiv sb kk) (idiv sa kk))
                x = (x + 1)
            }
            y = (y + 1)
        }
        return out
    }

    fn scaleTree:void (n:ErazerNode k:int) {
        n.x = (n.x * k)
        n.y = (n.y * k)
        n.w = (n.w * k)
        n.h = (n.h * k)
        n.fontSize = (n.fontSize * k)
        n.radius = (n.radius * k)
        n.borderW = (n.borderW * k)
        def i:int 0
        while (i < (array_length n.kids)) {
            def c:ErazerNode (itemAt n.kids i)
            this.scaleTree(c k)
            i = (i + 1)
        }
    }

    ; ---- outside OCR ---------------------------------------------------

    fn isTextRole:boolean (n:ErazerNode) {
        return ((n.role == "text") || (n.role == "label") || (n.role == "shape"))
    }

    ; The smallest non-text box that holds the whole rectangle.
    fn containerFor:ErazerNode (n:ErazerNode x:int y:int w:int h:int) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (((this.isTextRole(k)) == false) && (k.role != "underlay") && (k.role != "backdrop") && (k.coversBox(x y w h))) {
                return (this.containerFor(k x y w h))
            }
            i = (i + 1)
        }
        return n
    }

    fn wordOk:boolean (i:int) {
        if ((itemAt opts.wordConf i) < opts.wordMinConf) {
            return false
        }
        if ((this.wordChars((itemAt opts.wordText i))) == 0) {
            return false
        }
        if (((itemAt opts.wordW i) <= 0) || ((itemAt opts.wordH i) <= 0)) {
            return false
        }
        return true
    }

    ; A word under --wordMinConf, but not under --wordLowConf, is kept when
    ; the region pass found a text run under it: most of the run lies in
    ; the word's box.
    fn wordVouched:boolean (i:int runs:[ErazerNode]) {
        if ((itemAt opts.wordConf i) < opts.wordLowConf) {
            return false
        }
        if ((this.wordChars((itemAt opts.wordText i))) == 0) {
            return false
        }
        def wx:int (itemAt opts.wordX i)
        def wy:int (itemAt opts.wordY i)
        def ww:int (itemAt opts.wordW i)
        def wh:int (itemAt opts.wordH i)
        if ((ww <= 0) || (wh <= 0)) {
            return false
        }
        def r:int 0
        while (r < (array_length runs)) {
            def k:ErazerNode (itemAt runs r)
            def area:int (k.w * k.h)
            if ((k.ocrText == false) && (area > 0)) {
                def ix:int ((this.minI((wx + ww) (k.maxX()))) - (this.maxI(wx k.x)))
                def iy:int ((this.minI((wy + wh) (k.maxY()))) - (this.maxI(wy k.y)))
                if ((ix > 0) && (iy > 0) && (((ix * iy) * 10) >= (area * 6))) {
                    return true
                }
            }
            r = (r + 1)
        }
        return false
    }

    ; Word indices in reading order: by line (tops within half a height),
    ; then left to right.
    fn sortWords:void (ids:[int]) {
        def n:int (array_length ids)
        def i:int 1
        while (i < n) {
            def j:int i
            def go:boolean true
            while (go && (j > 0)) {
                def a:int (itemAt ids j)
                def b:int (itemAt ids (j - 1))
                def ay:int (itemAt opts.wordY a)
                def by:int (itemAt opts.wordY b)
                def half:int (idiv (this.maxI((itemAt opts.wordH a) (itemAt opts.wordH b))) 2)
                def before:boolean false
                if (ay < (by - half)) {
                    before = true
                } {
                    if (((this.absI((ay - by))) <= half) && ((itemAt opts.wordX a) < (itemAt opts.wordX b))) {
                        before = true
                    }
                }
                if before {
                    set ids j b
                    set ids (j - 1) a
                    j = (j - 1)
                } {
                    go = false
                }
            }
            i = (i + 1)
        }
    }

    fn sortWordsByX:void (ids:[int]) {
        def n:int (array_length ids)
        def i:int 1
        while (i < n) {
            def j:int i
            while ((j > 0) && ((itemAt opts.wordX (itemAt ids j)) < (itemAt opts.wordX (itemAt ids (j - 1))))) {
                def t:int (itemAt ids j)
                set ids j (itemAt ids (j - 1))
                set ids (j - 1) t
                j = (j - 1)
            }
            i = (i + 1)
        }
    }

    fn labelOfWords:ErazerNode (line:[int]) {
        def lx:int 100000
        def ly:int 100000
        def lmx:int 0
        def lmy:int 0
        def hs:[int]
        def q:int 0
        while (q < (array_length line)) {
            def wid:int (itemAt line q)
            lx = (this.minI(lx (itemAt opts.wordX wid)))
            ly = (this.minI(ly (itemAt opts.wordY wid)))
            lmx = (this.maxI(lmx ((itemAt opts.wordX wid) + (itemAt opts.wordW wid))))
            lmy = (this.maxI(lmy ((itemAt opts.wordY wid) + (itemAt opts.wordH wid))))
            push hs (itemAt opts.wordH wid)
            q = (q + 1)
        }
        ; a word box far taller than the line's (Tesseract gave "to" 30px
        ; on a 13px line) sets only the horizontal extent
        def med:int (this.medianInt(hs))
        def ty:int 100000
        def tmy:int 0
        def t:int 0
        while (t < (array_length line)) {
            def tid:int (itemAt line t)
            if (((itemAt opts.wordH tid) * 10) <= (med * 14)) {
                ty = (this.minI(ty (itemAt opts.wordY tid)))
                tmy = (this.maxI(tmy ((itemAt opts.wordY tid) + (itemAt opts.wordH tid))))
            }
            t = (t + 1)
        }
        if (tmy > ty) {
            ly = ty
            lmy = tmy
        }
        def lab:ErazerNode (ErazerNode.of("label" lx ly (lmx - lx) (lmy - ly) 0 0 0))
        lab.words = line
        lab.text = (this.joinWords(line))
        lab.ocrText = true
        lab.fontSize = (this.medianInt(hs))
        ; the least sure word of the line
        def least:int 100
        def cq:int 0
        while (cq < (array_length line)) {
            least = (this.minI(least (itemAt opts.wordConf (itemAt line cq))))
            cq = (cq + 1)
        }
        lab.confidence = ((to_double least) / 100.0)
        return lab
    }

    ; After the ink box tightened the label, a word left outside it was
    ; not this ink (the blue tick read as "v" beside "WiFi").
    fn keepInkWords:void (lab:ErazerNode) {
        def kept:[int]
        def i:int 0
        while (i < (array_length lab.words)) {
            def id:int (itemAt lab.words i)
            def wn:ErazerNode (ErazerNode.of("label" (itemAt opts.wordX id) (itemAt opts.wordY id) (itemAt opts.wordW id) (itemAt opts.wordH id) 0 0 0))
            def inside:boolean true
            if ((lab.inkX1 > lab.inkX0) && ((strlen (itemAt opts.wordText id)) <= 1)) {
                inside = (((wn.maxX()) > lab.inkX0) && (wn.x < lab.inkX1))
            }
            if inside {
                push kept id
            }
            i = (i + 1)
        }
        if (((array_length kept) > 0) && ((array_length kept) < (array_length lab.words))) {
            lab.words = kept
            lab.text = (this.joinWords(kept))
            def x0:int 100000
            def x1:int 0
            def j:int 0
            while (j < (array_length kept)) {
                def kid:int (itemAt kept j)
                x0 = (this.minI(x0 (itemAt opts.wordX kid)))
                x1 = (this.maxI(x1 ((itemAt opts.wordX kid) + (itemAt opts.wordW kid))))
                j = (j + 1)
            }
            lab.x = x0
            lab.w = (x1 - x0)
        }
        lab.fontSize = (this.cssFontOf(lab.text lab.h))
    }

    ; CSS font-size from the ink height of a known string. Ink from the
    ; top of an ascender to the foot of a descender is about 0.95 em; to
    ; the baseline (capitals, b d f h k l t) about 0.72 em; x-height only
    ; about 0.52 em.
    fn cssFontOf:int (text:string inkH:int) {
        def up:boolean false
        def down:boolean false
        def i:int 0
        while (i < (strlen text)) {
            def ch:string (substring text i (i + 1))
            if ((indexOf "ABCDEFGHIJKLMNOPQRSTUVWXYZbdfhklt0123456789" ch) >= 0) {
                up = true
            }
            if ((indexOf "gjpqy" ch) >= 0) {
                down = true
            }
            i = (i + 1)
        }
        def k:int 52
        if (up && down) {
            k = 95
        } {
            if up {
                k = 72
            } {
                if down {
                    k = 74
                }
            }
        }
        return (idiv ((inkH * 100) + (idiv k 2)) k)
    }

    fn joinWords:string (ids:[int]) {
        def out:string ""
        def i:int 0
        while (i < (array_length ids)) {
            if (i > 0) {
                out = (out + " ")
            }
            out = (out + (itemAt opts.wordText (itemAt ids i)))
            i = (i + 1)
        }
        return out
    }

    ; Mean of the pixels in the box that stand out most from bg: the ink.
    fn inkIn:void (n:ErazerNode bg:int) {
        def maxd:int 0
        def y:int n.y
        while (y < (n.maxY())) {
            def x:int n.x
            while (x < (n.maxX())) {
                def l:int (this.lumaAt(x y))
                if (l >= 0) {
                    def d:int (this.absI((l - bg)))
                    if (d > maxd) {
                        maxd = d
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        def sr:int 0
        def sg:int 0
        def sb:int 0
        def cnt:int 0
        def ix0:int 100000
        def iy0:int 100000
        def ix1:int (0 - 1)
        def iy1:int (0 - 1)
        def y2:int n.y
        while (y2 < (n.maxY())) {
            def x2:int n.x
            while (x2 < (n.maxX())) {
                if (img.isValidCoord(x2 y2)) {
                    def c:Color (img.getPixel(x2 y2))
                    def d2:int (this.absI(((this.lumaOf(c.r c.g c.b)) - bg)))
                    if (((d2 * 10) >= (maxd * 6)) && (maxd >= 24)) {
                        ix0 = (this.minI(ix0 x2))
                        iy0 = (this.minI(iy0 y2))
                        ix1 = (this.maxI(ix1 x2))
                        iy1 = (this.maxI(iy1 y2))
                        sr = (sr + c.r)
                        sg = (sg + c.g)
                        sb = (sb + c.b)
                        cnt = (cnt + 1)
                    }
                }
                x2 = (x2 + 1)
            }
            y2 = (y2 + 1)
        }
        ; OCR boxes run loose: the ink's rows are the label's height, and
        ; that height the glyph size.
        if ((cnt > 0) && (iy1 >= iy0)) {
            n.y = iy0
            n.h = ((iy1 - iy0) + 1)
            n.fontSize = n.h
        }
        if ((cnt > 0) && (ix1 >= ix0)) {
            n.inkX0 = ix0
            n.inkX1 = (ix1 + 1)
        }
        if (cnt > 0) {
            n.textR = (idiv sr cnt)
            n.textG = (idiv sg cnt)
            n.textB = (idiv sb cnt)
            n.r = n.textR
            n.g = n.textG
            n.b = n.textB
        }
    }

    ; Pieces of letters the region pass kept as boxes (a bold title's
    ; strokes as panels, an O as a checkbox) go when a label covers them.
    fn dropCovered:void (c:ErazerNode lab:ErazerNode) {
        def keep:[ErazerNode]
        def i:int 0
        while (i < (array_length c.kids)) {
            def k:ErazerNode (itemAt c.kids i)
            def inside:boolean ((k.x >= (lab.x - 2)) && (k.y >= (lab.y - 2)) && ((k.maxX()) <= ((lab.maxX()) + 2)) && ((k.maxY()) <= ((lab.maxY()) + 2)))
            if ((k != lab) && inside && (k.h <= (lab.h + 4))) {
                ; gone
            } {
                push keep k
            }
            i = (i + 1)
        }
        c.kids = keep
    }

    ; An OCR "word" that is mostly a control's box is the control read as
    ; letters: a nav icon comes back as "a", "tJ" or "%".
    fn onControl:boolean (n:ErazerNode lab:ErazerNode) {
        def area:int (lab.w * lab.h)
        if (area <= 0) {
            return false
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if ((this.isControl(k)) && (((this.overlapArea(k lab)) * 2) >= area)) {
                return true
            }
            if (this.onControl(k lab)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn removeNode:boolean (n:ErazerNode target:ErazerNode) {
        def keep:[ErazerNode]
        def hit:boolean false
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if (k == target) {
                hit = true
            } {
                push keep k
            }
            i = (i + 1)
        }
        if hit {
            n.kids = keep
            return true
        }
        def j:int 0
        while (j < (array_length n.kids)) {
            if (this.removeNode((itemAt n.kids j) target)) {
                return true
            }
            j = (j + 1)
        }
        return false
    }

    ; A word box that reaches up into a control above it ("Orders" taking
    ; in the bottom of its tab icon) starts where the control ends.
    fn clipUnderControls:void (n:ErazerNode lab:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            if ((this.isControl(k)) && ((this.overlapArea(k lab)) > 0) && ((k.cy()) < (lab.y + (idiv lab.h 2))) && ((k.maxY()) < (lab.maxY()))) {
                def bottom:int (lab.maxY())
                lab.y = (k.maxY())
                lab.h = (bottom - lab.y)
            }
            this.clipUnderControls(k lab)
            i = (i + 1)
        }
    }

    ; A short word centred in a small badge is the badge's glyph (a chart
    ; icon read as "all"), not a caption.
    ; At any scale: the badge is about square, and the "word" is at least a
    ; third of its height, where a caption inside a square button is small.
    fn badgeGlyph:boolean (box:ErazerNode lab:ErazerNode) {
        if (((strlen lab.text) > 3) || (box.role == "page")) {
            return false
        }
        if (((this.absI((box.w - box.h))) * 8) > box.w) {
            return false
        }
        if ((lab.h * 3) < box.h) {
            return false
        }
        def tol:int (this.maxI(4 (idiv box.h 8)))
        return (((this.absI(((lab.cx()) - (box.cx())))) <= tol) && ((this.absI(((lab.cy()) - (box.cy())))) <= tol))
    }

    fn isControl:boolean (n:ErazerNode) {
        return ((n.role == "switch") || (n.role == "checkbox") || (n.role == "slider") || (n.role == "sliderthumb") || (n.role == "icon"))
    }

    ; Text runs mostly inside the rectangle go: the OCR line replaces them.
    fn dropRunsIn:void (n:ErazerNode lab:ErazerNode) {
        def keep:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            def gone:boolean false
            if ((k != lab) && (this.isTextRole(k)) && ((k.w * k.h) > 0)) {
                if (((this.overlapArea(k lab)) * 2) >= (k.w * k.h)) {
                    gone = true
                }
            }
            if (gone == false) {
                push keep k
                this.dropRunsIn(k lab)
            }
            i = (i + 1)
        }
        n.kids = keep
    }

    ; Leaves the region pass made out of letters: a box with nothing in it
    ; that OCR labels cover for the most part (the strokes of a bold title,
    ; a "button" spanning two lines of a paragraph).
    fn dropLetterJunk:void (n:ErazerNode labs:[ErazerNode]) {
        def keep:[ErazerNode]
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            ; children first: a box whose only child was a letter piece is
            ; itself empty once the piece is gone
            this.dropLetterJunk(k labs)
            def gone:boolean false
            if ((k.ocrText == false) && ((array_length k.kids) == 0) && ((k.role == "panel") || (k.role == "button") || (k.role == "checkbox") || (k.role == "icon") || (k.role == "shape") || (k.role == "textfield") || (k.role == "text") || (k.role == "label"))) {
                def cover:int 0
                def j:int 0
                while (j < (array_length labs)) {
                    cover = (cover + (this.overlapArea(k (itemAt labs j))))
                    j = (j + 1)
                }
                if ((cover * 10) >= ((k.w * k.h) * 6)) {
                    gone = true
                }
            }
            if (gone == false) {
                push keep k
            }
            i = (i + 1)
        }
        n.kids = keep
    }

    ; Words from an outside OCR are the text. Each OCR line (split where a
    ; gap is wider than two word heights) becomes a label in the smallest
    ; box that holds it; the region pass's runs and letter pieces under it
    ; go. Words inside a control (a switch knob read as "J") are dropped.
    fn applyWords:void (page:ErazerNode) {
        def n:int (opts.wordCount())
        if (n == 0) {
            return
        }
        ; text the region pass found on its own vouches for a word OCR is
        ; unsure of ("Wed" at 38%, "$32.575" at 51%)
        def runs:[ErazerNode]
        this.collectTexts(page runs)
        def ids:[int]
        def i:int 0
        while (i < n) {
            if ((this.wordOk(i)) || (this.wordVouched(i runs))) {
                push ids i
            }
            i = (i + 1)
        }
        this.sortWords(ids)
        ; the page's usual word height: a word box that took in the icon
        ; above it is two or three times that
        def whs:[int]
        def wi:int 0
        while (wi < (array_length ids)) {
            push whs (itemAt opts.wordH (itemAt ids wi))
            wi = (wi + 1)
        }
        def usualH:int (this.medianInt(whs))
        def used:[int]
        def u:int 0
        while (u < (array_length ids)) {
            push used 0
            u = (u + 1)
        }
        def lines:[ErazerNode]
        def a:int 0
        while (a < (array_length ids)) {
            if ((itemAt used a) == 0) {
                set used a 1
                def first:int (itemAt ids a)
                def lid:int (itemAt opts.wordLine first)
                def cy0:int ((itemAt opts.wordY first) + (idiv (itemAt opts.wordH first) 2))
                def hh:int (itemAt opts.wordH first)
                ; everything on the same OCR line (or, without line ids, the
                ; same row), then left to right
                def row:[int]
                push row first
                def b:int (a + 1)
                while (b < (array_length ids)) {
                    def id:int (itemAt ids b)
                    if ((itemAt used b) == 0) {
                        def same:boolean false
                        if (lid >= 0) {
                            same = ((itemAt opts.wordLine id) == lid)
                        } {
                            def cy1:int ((itemAt opts.wordY id) + (idiv (itemAt opts.wordH id) 2))
                            same = ((this.absI((cy1 - cy0))) <= (idiv hh 2))
                        }
                        if same {
                            push row id
                            set used b 1
                        }
                    }
                    b = (b + 1)
                }
                this.sortWordsByX(row)
                ; split where the gap is wider than two word heights: a
                ; row's label and its far-right value are two labels. The
                ; smaller of the two neighbours sets the height: a word box
                ; that took in the icon above it ("Analytics" 31px tall over
                ; 11px letters) does not join a row of icon captions.
                def line:[int]
                def right:int (0 - 100000)
                def prevH:int hh
                def r:int 0
                while (r < (array_length row)) {
                    def wid:int (itemAt row r)
                    def gap:int ((itemAt opts.wordX wid) - right)
                    def gh:int (this.minI(prevH (itemAt opts.wordH wid)))
                    ; two captions whose boxes both reach into their icons
                    ; ("Analytics" and "Customers", 30px each over 11px
                    ; letters, 48px apart) are still two
                    def capH:int (idiv (usualH * 3) 2)
                    if ((usualH > 0) && (gh > capH)) {
                        gh = capH
                    }
                    if (((array_length line) > 0) && (gap > ((gh * 2) + 2))) {
                        push lines (this.labelOfWords(line))
                        def fresh:[int]
                        line = fresh
                    }
                    push line wid
                    prevH = (itemAt opts.wordH wid)
                    right = (this.maxI(right ((itemAt opts.wordX wid) + (itemAt opts.wordW wid))))
                    r = (r + 1)
                }
                if ((array_length line) > 0) {
                    push lines (this.labelOfWords(line))
                }
            }
            a = (a + 1)
        }
        ; one tall character among ordinary lines is a mark, not a word
        def lh:[int]
        def m:int 0
        while (m < (array_length lines)) {
            def l0:ErazerNode (itemAt lines m)
            push lh l0.h
            m = (m + 1)
        }
        def medH:int (this.medianInt(lh))
        def placed:[ErazerNode]
        def p:int 0
        while (p < (array_length lines)) {
            def lab2:ErazerNode (itemAt lines p)
            def box:ErazerNode (this.containerFor(page lab2.x lab2.y lab2.w lab2.h))
            def mark:boolean (((strlen lab2.text) <= 1) && ((lab2.h * 10) > (medH * 18)))
            ; one character at the image edge is a frame's rounded corner
            ; read as "A" or "y"
            def atEdge:boolean ((lab2.x <= 1) || (lab2.y <= 1) || ((lab2.maxX()) >= (page.w - 1)) || ((lab2.maxY()) >= (page.h - 1)))
            if (((this.wordChars(lab2.text)) <= 1) && atEdge) {
                mark = true
            }
            this.clipUnderControls(page lab2)
            ; a sure word of three letters or more is text even where the
            ; region pass made a "checkbox" of its letters ("Fri" at 96%)
            def sure:boolean ((lab2.confidence >= 0.9) && ((this.wordChars(lab2.text)) >= 3))
            ; ... and when the "control" it lands in is its own letters (a
            ; box the word covers for the most part), the box goes
            if (sure && (this.isControl(box)) && (((this.overlapArea(box lab2)) * 10) >= ((box.w * box.h) * 6))) {
                this.removeNode(page box)
                box = (this.containerFor(page lab2.x lab2.y lab2.w lab2.h))
            }
            def onCtl:boolean ((sure == false) && (this.onControl(page lab2)))
            if (((this.isControl(box)) == false) && (mark == false) && (onCtl == false) && ((this.badgeGlyph(box lab2)) == false)) {
                this.inkIn(lab2 (this.localBgLuma(lab2)))
                this.keepInkWords(lab2)
                this.dropRunsIn(page lab2)
                this.dropCovered(box lab2)
                box.addKid(lab2)
                push placed lab2
            }
            p = (p + 1)
        }
        this.dropLetterJunk(page placed)
        this.refreshControlText(page)
    }

    ; A button or field shows the text of its first run.
    fn refreshControlText:void (n:ErazerNode) {
        if ((n.role == "button") || (n.role == "textfield") || (n.role == "tab") || (n.role == "menuitem")) {
            def hit@(optional):ErazerNode (this.firstText(n))
            if hit {
                this.copyTextOnto(n (unwrap hit))
            }
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            this.refreshControlText(k)
            i = (i + 1)
        }
    }

    fn collectTexts:void (n:ErazerNode out:[ErazerNode]) {
        if ((n.role == "text") || (n.role == "label")) {
            push out n
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            this.collectTexts((itemAt n.kids i) out)
            i = (i + 1)
        }
    }

    ; A "checkbox" with a caption centred under it, and none beside it, is
    ; an icon (a tab bar's Orders / Analytics / Settings); so is one centred
    ; in a badge at least twice its size. A checkbox's own label sits on
    ; its right.
    fn iconsFromCheckboxes:void (n:ErazerNode par:ErazerNode texts:[ErazerNode]) {
        def i:int 0
        while (i < (array_length n.kids)) {
            this.iconsFromCheckboxes((itemAt n.kids i) n texts)
            i = (i + 1)
        }
        if (n.role != "checkbox") {
            return
        }
        def beside:boolean false
        def below:boolean false
        def t:int 0
        while (t < (array_length texts)) {
            def k:ErazerNode (itemAt texts t)
            if (((this.absI(((k.cy()) - (n.cy())))) <= (idiv n.h 2)) && (k.x >= (n.maxX())) && ((k.x - (n.maxX())) <= (n.w * 3))) {
                beside = true
            }
            def gap:int (k.y - (n.maxY()))
            def overlapX:boolean ((k.x < (n.maxX())) && ((k.maxX()) > n.x))
            if ((gap >= 0) && (gap <= (this.maxI(n.h 12))) && overlapX && ((this.absI(((k.cx()) - (n.cx())))) <= (this.maxI(n.w 12)))) {
                below = true
            }
            t = (t + 1)
        }
        def badge:boolean false
        if ((par.role != "page") && (par.w >= (n.w * 2)) && (par.h >= (n.h * 2)) && ((this.absI(((par.cx()) - (n.cx())))) <= 3) && ((this.absI(((par.cy()) - (n.cy())))) <= 3)) {
            badge = true
        }
        if ((beside == false) && (below || badge) && ((this.solidBox(n)) == false)) {
            n.role = "icon"
            n.confidence = 0.7
            this.traceIcons(n)
        }
    }

    ; Names each icon with the recogniser. A "checkbox" the recogniser is
    ; sure is some other icon (a gear, a bell) becomes an icon too.
    fn underWords:boolean (n:ErazerNode box:ErazerNode) {
        if ((n != box) && n.ocrText && ((this.overlapArea(n box)) > 0)) {
            return true
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            if (this.underWords((itemAt n.kids i) box)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn nameIcons:void (n:ErazerNode net:ErazerIcons root:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            this.nameIcons((itemAt n.kids i) net root)
            i = (i + 1)
        }
        if ((n.role != "icon") && (n.role != "checkbox")) {
            return
        }
        if ((n.w < 8) || (n.h < 8)) {
            return
        }
        def g:ErazerIconGuess (net.classify(img n.x n.y n.w n.h n.r n.g n.b))
        if ((strlen g.name) == 0) {
            return
        }
        def boxy:boolean ((g.name == "checkbox") || (g.name == "square") || (g.name == "check") || (g.name == "check-circle") || (g.name == "circle") || (g.name == "none"))
        ; a letter pair the reader left as a small "checkbox" ("ly" in
        ; Analytics, 12×9) is not promoted: icons are bigger than text
        ; nor a letter of an OCR word ("$" of "$189" at 3x, 52×48)
        if ((n.role == "checkbox") && (boxy == false) && (g.confidence >= 0.85) && (n.w >= 14) && (n.h >= 14) && ((this.underWords(root n)) == false)) {
            n.role = "icon"
            n.confidence = 0.7
            this.traceIcons(n)
        }
        if ((n.role == "icon") && (g.name != "none") && (g.confidence >= opts.iconMinConf)) {
            n.iconName = g.name
            n.iconConf = g.confidence
        }
    }

    ; Nothing but its own fill inside the box: a chart bar or a swatch,
    ; where an icon shows the background through its strokes.
    fn solidBox:boolean (n:ErazerNode) {
        def pixels:buffer img.pixels
        def hit:int 0
        def tot:int 0
        def y:int (n.y + 3)
        while ((y < ((n.maxY()) - 3)) && (y < img.height)) {
            def x:int (n.x + 3)
            while ((x < ((n.maxX()) - 3)) && (x < img.width)) {
                def off:int (((y * img.width) + x) * 4)
                tot = (tot + 1)
                if (this.colorNear((buffer_get pixels off) (buffer_get pixels (off + 1)) (buffer_get pixels (off + 2)) n.r n.g n.b 40) == false) {
                    hit = (hit + 1)
                }
                x = (x + 2)
            }
            y = (y + 2)
        }
        return ((tot > 0) && ((hit * 12) < tot))
    }

    ; An edge a label shares with a sibling label in the same container is
    ; its alignment: the lines of a paragraph share a left edge, whatever
    ; the margins of the card they sit in.
    fn sharedEdge:string (n:ErazerNode k:ErazerNode) {
        def l:int 0
        def r:int 0
        def c:int 0
        def i:int 0
        while (i < (array_length n.kids)) {
            def o:ErazerNode (itemAt n.kids i)
            if ((o != k) && ((o.role == "text") || (o.role == "label"))) {
                if ((this.absI((o.x - k.x))) <= 3) {
                    l = (l + 1)
                }
                if ((this.absI(((o.maxX()) - (k.maxX())))) <= 3) {
                    r = (r + 1)
                }
                if ((this.absI(((o.cx()) - (k.cx())))) <= 3) {
                    c = (c + 1)
                }
            }
            i = (i + 1)
        }
        if ((l >= r) && (l >= c) && (l > 0)) {
            return "left"
        }
        if ((c >= r) && (c > 0)) {
            return "center"
        }
        if (r > 0) {
            return "right"
        }
        return ""
    }

    ; A label just under a sibling box, centred on it, is that box's caption
    ; (an icon's name in a tab bar or a shortcut row).
    fn captionOf:boolean (n:ErazerNode k:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def o:ErazerNode (itemAt n.kids i)
            if ((o != k) && (o.role != "text") && (o.role != "label") && (o.w >= 12)) {
                def gap:int (k.y - (o.maxY()))
                def tol:int (this.maxI(3 (idiv o.w 6)))
                if ((gap >= 0) && (gap <= (this.maxI(k.h 12))) && ((this.absI(((k.cx()) - (o.cx())))) <= tol)) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; Where each label sits: an edge shared with sibling labels, or else
    ; the side of its container it hugs, or the middle when the two
    ; margins match. A label that nearly fills its box says nothing.
    fn alignTexts:void (n:ErazerNode) {
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            def shared:string (this.sharedEdge(n k))
            ; a right or centre edge shared by chance ("Settings…" ending
            ; where "Other Networks" ends) does not beat a label that hugs
            ; its container's left side
            def lg0:int (k.x - n.x)
            def rg0:int ((n.maxX()) - (k.maxX()))
            if ((shared == "right") && (rg0 >= lg0)) {
                shared = ""
            }
            if ((shared == "center") && ((this.absI((lg0 - rg0))) > (this.maxI(8 (idiv (lg0 + rg0) 4))))) {
                shared = ""
            }
            if (((k.role == "text") || (k.role == "label")) && (this.captionOf(n k))) {
                shared = "center"
            }
            if (((k.role == "text") || (k.role == "label")) && ((strlen shared) > 0)) {
                k.align = shared
            }
            if (((k.role == "text") || (k.role == "label")) && ((strlen shared) == 0)) {
                def lg:int (k.x - n.x)
                def rg:int ((n.maxX()) - (k.maxX()))
                def slack:int (lg + rg)
                if (slack >= 8) {
                    def tol:int (this.maxI(4 (idiv slack 8)))
                    if (((this.absI((lg - rg))) <= tol) && (lg > 8)) {
                        k.align = "center"
                    } {
                        if (rg < lg) {
                            k.align = "right"
                        } {
                            k.align = "left"
                        }
                    }
                }
            }
            this.alignTexts(k)
            i = (i + 1)
        }
    }

    fn run:ErazerDoc () {
        def fullW:int img.width
        def fullH:int img.height
        def k:int (this.pickScale())
        def full:ImageBuffer img
        if (k > 1) {
            img = (this.boxDown(k))
        }
        def w:int img.width
        def h:int img.height
        def raws:[ErazerRaw] (this.components())
        this.dropCornerSlivers(raws)
        this.stitchGlyphs(raws)
        this.adoptInline(raws)
        def texts:[ErazerNode] (this.clusterText(raws))
        def pageColorR:int 255
        def pageColorG:int 255
        def pageColorB:int 255
        def pageIdx:int (0 - 1)
        def i:int 0
        while (i < (array_length raws)) {
            def r:ErazerRaw (itemAt raws i)
            if (this.fullBleed(r w h)) {
                pageColorR = r.r
                pageColorG = r.g
                pageColorB = r.b
                pageIdx = i
                r.used = true
            }
            i = (i + 1)
        }
        def page:ErazerNode (ErazerNode.of("page" 0 0 w h pageColorR pageColorG pageColorB))
        page.confidence = 1.0
        if (pageIdx >= 0) {
            this.copyGrad(page (itemAt raws pageIdx))
        }
        def nodes:[ErazerNode]
        def j:int 0
        while (j < (array_length raws)) {
            def raw:ErazerRaw (itemAt raws j)
            if (raw.used == false) {
                if (raw.kind != "glyph") {
                    if (raw.kind != "line") {
                        def role:string "panel"
                        if (raw.kind == "icon") {
                            role = "icon"
                        }
                        if (raw.kind == "box") {
                            role = "panel"
                        }
                        if (raw.kind == "frame") {
                            role = "panel"
                        }
                        push nodes (this.nodeFromRaw(raw role))
                    }
                }
            }
            j = (j + 1)
        }
        def t:int 0
        while (t < (array_length texts)) {
            push nodes (itemAt texts t)
            t = (t + 1)
        }
        this.mergeFrameFill(nodes)
        this.splitRows(nodes page raws)
        def under:[ErazerNode] (this.splitBackdrop(nodes page))
        this.nest(nodes page)
        this.layerUnder(page under)
        this.classifyTree(page)
        this.relabelTexts(page)
        this.promoteGroups(page)
        this.dropImplausibleText(page (this.medianFont(page)))
        this.relabelTexts(page)
        this.traceIcons(page)
        if (k > 1) {
            this.scaleTree(page k)
            page.w = fullW
            page.h = fullH
            w = fullW
            h = fullH
        }
        img = full
        this.applyWords(page)
        this.relabelTexts(page)
        def texts2:[ErazerNode]
        this.collectTexts(page texts2)
        this.iconsFromCheckboxes(page page texts2)
        if opts.nameIcons {
            this.nameIcons(page (ErazerIcons.shared()) page)
        }
        this.alignTexts(page)
        def boxes:[ErazerLayoutBox] (ErazerLayoutNet.boxesFromTree(page w h))
        def net:ErazerLayoutNet (ErazerLayoutNet.shared())
        def guesses:[ErazerLayoutGuess] (net.scan(boxes))
        def doc (new ErazerDoc())
        doc.width = w
        doc.height = h
        doc.root = page
        def evg:EVGElement (this.emitNode(page 0 0))
        evg.position = "relative"
        doc.json = (EVGTreeJson.toText(evg))
        doc.outline = (this.writeOutline(page ""))
        doc.layoutJson = (net.toJson(boxes guesses))
        doc.overlaySvg = (this.writeOverlay(page w h guesses))
        return doc
    }
}
