                def hi:int (itemAt span 1)
                def thin:boolean ((y2 - y) <= 2)
                if (thin && ((this.rowCover(box (y - 3) span)) < 25) && ((this.rowCover(box (y2 + 3) span)) < 25)) {
                    def inner:boolean false
