; ==============================================================================
; ErazerPaint.rgr — synthetic UI screenshots for Erazer tests and the live page
; ==============================================================================
;
; Painted with ErazerFont so the recogniser's 5×7 atlas is a round-trip, not a
; guess. The fixtures stand in for the widgets a screenshot of a UI library
; would contain: a form, tabs, a menu, a checkbox, a labelled icon,
; a same-row chip strip, range sliders, and an iOS grouped settings list.
; ==============================================================================

Import "pkg:image/ImageBuffer.rgr"
Import "ErazerFont.rgr"
Import "Erazer.rgr"

class ErazerPaint {

    Constructor () {
    }

    sfn blank:ImageBuffer (w:int h:int r:int g:int b:int) {
        def img (new ImageBuffer())
        img.init(w h)
        ErazerFont.fillRect(img 0 0 w h r g b)
        return img
    }

    sfn paintLabel:void (img:ImageBuffer x:int y:int text:string) {
        ErazerFont.paintText(img x y 2 17 24 39 text)
    }

    sfn paintCentered:void (img:ImageBuffer x:int y:int w:int h:int text:string r:int g:int b:int) {
        def tw:int (ErazerFont.textWidth(text 2))
        def th:int (ErazerFont.textHeight(2))
        def tx:int (x + (idiv (w - tw) 2))
        def ty:int (y + (idiv (h - th) 2))
        ErazerFont.paintText(img tx ty 2 r g b text)
    }

    ; A login-shaped card: two fields, a checkbox, a primary button.
    sfn form:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(320 240 232 236 240))
        ErazerFont.fillRoundRect(img 16 16 288 208 8 255 255 255)
        ErazerPaint.paintLabel(img 32 32 "Name")
        ErazerFont.fillRoundRect(img 32 52 256 32 4 209 213 219)
        ErazerPaint.paintLabel(img 32 96 "Email")
        ErazerFont.fillRoundRect(img 32 116 256 32 4 209 213 219)
        ErazerFont.strokeRect(img 32 160 16 16 2 55 65 81)
        ErazerPaint.paintLabel(img 54 162 "On")
        ErazerFont.fillRoundRect(img 200 176 88 32 6 37 99 235)
        ErazerPaint.paintCentered(img 200 176 88 32 "OK" 255 255 255)
        return img
    }

    ; Three tabs on a bar, the first selected.
    sfn tabs:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(320 80 229 231 235))
        ErazerFont.fillRect(img 12 12 296 48 156 163 175)
        ErazerFont.fillRoundRect(img 16 16 92 36 4 255 255 255)
        ErazerPaint.paintCentered(img 16 16 92 36 "File" 17 24 39)
        ErazerFont.fillRoundRect(img 112 16 92 36 4 229 231 235)
        ErazerPaint.paintCentered(img 112 16 92 36 "Edit" 17 24 39)
        ErazerFont.fillRoundRect(img 208 16 92 36 4 243 244 246)
        ErazerPaint.paintCentered(img 208 16 92 36 "View" 17 24 39)
        return img
    }

    ; A vertical menu of three items.
    sfn menu:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(220 160 229 231 235))
        ErazerFont.fillRoundRect(img 20 16 180 128 6 255 255 255)
        ErazerFont.fillRect(img 24 20 172 36 219 234 254)
        ErazerPaint.paintLabel(img 36 28 "File")
        ErazerFont.fillRect(img 24 60 172 36 224 231 255)
        ErazerPaint.paintLabel(img 36 68 "Edit")
        ErazerFont.fillRect(img 24 100 172 36 199 210 254)
        ErazerPaint.paintLabel(img 36 108 "View")
        return img
    }

    ; A plus-shaped icon beside a label, the case the tracer is asked to SVG.
    sfn iconRow:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(200 64 255 255 255))
        ; plus: 20×20, 4 px bars, connected at the centre
        ErazerFont.fillRect(img 20 28 20 4 17 24 39)
        ErazerFont.fillRect(img 28 20 4 20 17 24 39)
        ErazerPaint.paintLabel(img 52 22 "Add")
        return img
    }

    sfn button:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(160 64 232 236 240))
        ErazerFont.fillRoundRect(img 24 16 112 32 6 37 99 235)
        ErazerPaint.paintCentered(img 24 16 112 32 "Login" 255 255 255)
        return img
    }

    ; Three same-row chips: two compact, one much wider. The wide one is
    ; past the single-widget button width cap, so only a sibling-row
    ; heuristic labels all three as buttons.
    sfn chipRow:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(560 80 232 236 240))
        ErazerFont.fillRoundRect(img 12 22 88 36 6 243 244 246)
        ErazerFont.strokeRect(img 12 22 88 36 1 156 163 175)
        ErazerPaint.paintCentered(img 12 22 88 36 "Rest" 17 24 39)
        ErazerFont.fillRoundRect(img 108 22 88 36 6 243 244 246)
        ErazerFont.strokeRect(img 108 22 88 36 1 156 163 175)
        ErazerPaint.paintCentered(img 108 22 88 36 "Sick" 17 24 39)
        ErazerFont.fillRoundRect(img 204 22 340 36 6 243 244 246)
        ErazerFont.strokeRect(img 204 22 340 36 1 156 163 175)
        ErazerPaint.paintCentered(img 204 22 340 36 "Ready" 17 24 39)
        return img
    }

    ; Unequal chips like Lepopaiva / Sairas / Valmentaja paikalla: similar
    ; height and fill, different widths — a tab heuristic must not steal them.
    sfn chipStrip:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(540 80 232 236 240))
        ErazerFont.fillRoundRect(img 12 22 150 36 6 243 244 246)
        ErazerFont.strokeRect(img 12 22 150 36 1 156 163 175)
        ErazerPaint.paintCentered(img 12 22 150 36 "Rest" 17 24 39)
        ErazerFont.fillRoundRect(img 170 22 110 36 6 243 244 246)
        ErazerFont.strokeRect(img 170 22 110 36 1 156 163 175)
        ErazerPaint.paintCentered(img 170 22 110 36 "Sick" 17 24 39)
        ErazerFont.fillRoundRect(img 288 22 236 36 6 243 244 246)
        ErazerFont.strokeRect(img 288 22 236 36 1 156 163 175)
        ErazerPaint.paintCentered(img 288 22 236 36 "Ready" 17 24 39)
        return img
    }

    sfn paintSliderRow:void (img:ImageBuffer x:int y:int trackW:int fillW:int) {
        ErazerFont.fillRoundRect(img x (y + 10) trackW 8 4 209 213 219)
        def fw:int fillW
        if (fw < 8) {
            fw = 8
        }
        if (fw > trackW) {
            fw = trackW
        }
        ErazerFont.fillRoundRect(img x (y + 10) fw 8 4 30 58 138)
        def thumbX:int ((x + fw) - 9)
        if (thumbX < x) {
            thumbX = x
        }
        ErazerFont.fillRoundRect(img thumbX (y + 5) 18 18 9 255 255 255)
        ErazerFont.strokeRect(img thumbX (y + 5) 18 18 1 30 58 138)
        def boxX:int ((x + trackW) + 12)
        ErazerFont.fillRoundRect(img boxX (y + 2) 32 24 4 243 244 246)
        ErazerFont.strokeRect(img boxX (y + 2) 32 24 1 209 213 219)
        ErazerPaint.paintCentered(img boxX (y + 2) 32 24 "4" 17 24 39)
    }

    ; One range control: track, circular thumb, numeric box.
    sfn slider:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(400 56 255 255 255))
        ErazerPaint.paintSliderRow(img 16 16 280 160)
        return img
    }

    ; Three stacked sliders, the shape of a rating row on a form.
    sfn sliders:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(400 160 255 255 255))
        ErazerPaint.paintSliderRow(img 16 16 280 200)
        ErazerPaint.paintSliderRow(img 16 64 280 80)
        ErazerPaint.paintSliderRow(img 16 112 280 220)
        return img
    }

    sfn paintSwitch:void (img:ImageBuffer x:int y:int on:boolean) {
        if on {
            ErazerFont.fillRoundRect(img x y 50 30 15 52 199 89)
            ErazerFont.fillRoundRect(img (x + 22) (y + 2) 26 26 13 255 255 255)
        } {
            ErazerFont.fillRoundRect(img x y 50 30 15 233 233 235)
            ErazerFont.fillRoundRect(img (x + 2) (y + 2) 26 26 13 255 255 255)
        }
    }

    ; One card of rows: white on the off-white page, a hairline between
    ; rows that stops short of the left edge, a switch at the right end.
    sfn paintGroup:void (img:ImageBuffer y:int labels:[string]) {
        def n:int (array_length labels)
        def rowH:int 44
        ErazerFont.fillRoundRect(img 16 y 328 (n * rowH) 10 255 255 255)
        def i:int 0
        while (i < n) {
            def ry:int (y + (i * rowH))
            ErazerPaint.paintLabel(img 32 (ry + 15) (itemAt labels i))
            ErazerPaint.paintSwitch(img 282 (ry + 7) ((i - ((idiv i 2) * 2)) == 0))
            if (i < (n - 1)) {
                ErazerFont.fillRect(img 32 ((ry + rowH) - 1) 312 1 198 198 200)
            }
            i = (i + 1)
        }
    }

    ; The shape of an iOS Settings screen: a home-indicator bar (a thin
    ; pill, NOT a slider) and two cards of switch rows.
    sfn groupedList:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(360 400 242 242 247))
        ErazerFont.fillRoundRect(img 120 10 120 6 3 17 17 17)
        ErazerPaint.paintGroup(img 40 ([] _:string ("Grid" "Level" "Mirror")))
        ErazerPaint.paintGroup(img 200 ([] _:string ("Scan" "Burst" "Text")))
        return img
    }

    ; The same cards over a blurred backdrop: a left-to-right gradient
    ; from lavender-grey to purple, under one step per pixel.
    sfn frostedList:ImageBuffer () {
        def img:ImageBuffer (ErazerPaint.blank(360 400 200 202 214))
        def x:int 0
        while (x < 360) {
            def r:int (200 - (idiv (x * 60) 360))
            def g:int (202 - (idiv (x * 58) 360))
            def b:int (214 - (idiv (x * 14) 360))
            ErazerFont.fillRect(img x 0 1 400 r g b)
            x = (x + 1)
        }
        ErazerFont.fillRoundRect(img 120 10 120 6 3 17 17 17)
        ErazerPaint.paintGroup(img 40 ([] _:string ("Grid" "Level" "Mirror")))
        ErazerPaint.paintGroup(img 200 ([] _:string ("Scan" "Burst" "Text")))
        return img
    }
}
