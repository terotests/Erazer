; ==============================================================================
; ErazerTest.rgr — bitmap UI → EVG layout
; ==============================================================================
;
; Fixtures are painted with the same 5×7 face the recogniser reads, so a
; missed button or a wrong font size is a real miss, not a font-rasteriser
; disagreement. The shapes stand in for what a screenshot of a UI library
; would contain.
;
;   npm run erazer:test
; ==============================================================================

Import "Erazer.rgr"
Import "ErazerPaint.rgr"
Import "ErazerFont.rgr"
Import "ErazerLayout.rgr"
Import "ErazerIcons.rgr"
Import "../game_engine/v2/tests/harness/RgTest.rgr"

class ErazerTest {

    sfn m@(main):void () {
        def test (new ErazerTest())
        def t:RgTest (RgTest.forSuite("gallery/erazer"))
        test.testAtlas(t)
        test.testOcr(t)
        test.testBlank(t)
        test.testButton(t)
        test.testForm(t)
        test.testTabs(t)
        test.testMenu(t)
        test.testIcon(t)
        test.testIconNames(t)
        test.testLightIcon(t)
        test.testChipRow(t)
        test.testChipStrip(t)
        test.testSlider(t)
        test.testSliders(t)
        test.testGroupedList(t)
        test.testFrostedList(t)
        test.testCornersAndRows(t)
        test.testTextDoubt(t)
        test.testOutsideWords(t)
        test.testCaptionWords(t)
        test.testJson(t)
        test.testLayoutFeatures(t)
        test.testLayoutLearn(t)
        test.testLayoutStructure(t)
        test.testLayoutWeights(t)
        t.summary()
    }

    fn testAtlas:void (t:RgTest) {
        def abc:string (ErazerFont.alphabet())
        def data:string (ErazerFont.atlas())
        t.eqInt("atlas covers the alphabet" (strlen data) ((strlen abc) * 35))
        def a:string (ErazerFont.bitsFor("A"))
        t.eqInt("glyph A is 35 bits" (strlen a) 35)
        t.eqBool("A has a top bar" (ErazerFont.cellOn(a 1 0)) true)
    }

    fn testOcr:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.blank(140 40 255 255 255))
        ErazerFont.paintText(img 10 8 2 17 24 39 "OK")
        def doc:ErazerDoc (Erazer.analyze(img))
        def hit@(optional):ErazerNode (doc.root.findText("OK"))
        t.ok("ocr reads OK" ((null? hit) == false))
        if (null? hit) {

        } {
            def n:ErazerNode (unwrap hit)
            t.ok("ocr font size ~14" ((n.fontSize >= 10) && (n.fontSize <= 18)))
            t.ok("ocr ink is dark" ((n.textR < 80) && (n.textG < 80)))
        }
    }

    fn testBlank:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.blank(64 48 232 236 240))
        def doc:ErazerDoc (Erazer.analyze(img))
        t.eqStr("blank root is page" doc.root.role "page")
        t.eqInt("blank is 64 wide" doc.width 64)
        t.eqInt("blank is 48 tall" doc.height 48)
    }

    fn testButton:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.button())
        def doc:ErazerDoc (Erazer.analyze(img))
        t.ok("button found" ((doc.root.roleCount("button")) >= 1))
        def hit@(optional):ErazerNode (doc.root.findRole("button"))
        if (null? hit) {

            t.ok("button labelled Login" false)
        } {
            def n:ErazerNode (unwrap hit)
            t.eqStr("button labelled Login" n.text "Login")
            t.ok("button fill is blue" ((n.b > n.r) && (n.b > 150)))
            t.ok("button ink is light" (n.textR > 200))
            t.ok("button font ~14" ((n.fontSize >= 10) && (n.fontSize <= 18)))
        }
    }

