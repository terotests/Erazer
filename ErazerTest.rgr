    ; Screenshot 1 of the bug report: cards melted into the page, rows were
    ; never found, the home indicator read as a slider, and the layout net
    ; drew one page-tall "list" through every card.
    fn testGroupedList:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.groupedList())
        def doc:ErazerDoc (Erazer.analyze(img))
        t.eqInt("a thin bar alone is not a slider" (doc.root.roleCount("slider")) 0)
        t.eqInt("six switches" (doc.root.roleCount("switch")) 6)
        t.eqInt("hairlines split the cards into six rows" (doc.root.roleCount("listitem")) 6)
        t.eqInt("each card is a list" (doc.root.roleCount("list")) 2)
        def hit@(optional):ErazerNode (doc.root.findText("Level"))
        t.ok("a row label is read" ((null? hit) == false))
        def root:ErazerNode (unwrap doc.root)
        def boxes:[ErazerLayoutBox] (ErazerLayoutNet.boxesFromTree(root doc.width doc.height))
        def net:ErazerLayoutNet (ErazerLayoutNet.shared())
        def guesses:[ErazerLayoutGuess] (net.scan(boxes))
        def tall:int 0
        def i:int 0
        while (i < (array_length guesses)) {
            def g:ErazerLayoutGuess (itemAt guesses i)
            if (g.h > 160.0) {
                tall = (tall + 1)
            }
            i = (i + 1)
        }
        t.eqInt("no layout group runs across both cards" tall 0)
    }

    ; Content boxes either nest or stay apart; a box that runs across
    ; another belongs in the underlay.
    fn crossings:int (n:ErazerNode) {
        def c:int 0
        def i:int 0
        while (i < (array_length n.kids)) {
            def a:ErazerNode (itemAt n.kids i)
            if (a.role != "underlay") {
                def j:int (i + 1)
                while (j < (array_length n.kids)) {
                    def b:ErazerNode (itemAt n.kids j)
                    if ((b.role != "underlay") && ((a.w * a.h) >= 400) && ((b.w * b.h) >= 400)) {
                        def ox:boolean ((a.x < (b.maxX())) && (b.x < (a.maxX())))
                        def oy:boolean ((a.y < (b.maxY())) && (b.y < (a.maxY())))
                        if (ox && oy) {
                            c = (c + 1)
                        }
                    }
                    j = (j + 1)
                }
                c = (c + (this.crossings(a)))
            }
            i = (i + 1)
        }
        return c
    }

    ; Screenshot 2: a blurred purple backdrop came apart into bands and
    ; slivers whose boxes ran through the cards.
    fn testFrostedList:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.frostedList())
        def doc:ErazerDoc (Erazer.analyze(img))
        def root:ErazerNode (unwrap doc.root)
        t.eqInt("a gradient backdrop stays one surface" (root.roleCount("backdrop")) 0)
        t.eqInt("both cards are lists over it" (root.roleCount("list")) 2)
        t.eqInt("six rows over the gradient" (root.roleCount("listitem")) 6)
        t.eqInt("no content boxes cross" (this.crossings(root)) 0)
        t.eqInt("the backdrop is a left-to-right gradient" root.gradDir 1)
        t.ok("it runs light to dark" (root.gFromR > (root.gToR + 30)))
        t.ok("the gradient reaches the JSON" ((indexOf doc.json "gradient-from") >= 0))
    }

    ; Cards are painted with a 10px corner. The corner probe read the
    ; diagonal inset (about 3px) as the radius.
    fn testCornersAndRows:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.groupedList())
        def doc:ErazerDoc (Erazer.analyze(img))
        def root:ErazerNode (unwrap doc.root)
        def hit@(optional):ErazerNode (root.findRole("list"))
        if (null? hit) {
            t.ok("a card to measure" false)
        } {
            def card:ErazerNode (unwrap hit)

            t.ok("card radius is about 10" ((card.radius >= 8) && (card.radius <= 12)))
        }
        def sw@(optional):ErazerNode (root.findRole("switch"))
        if (null? sw) {
            t.ok("a switch to measure" false)
        } {
            def s1:ErazerNode (unwrap sw)
            t.ok("switch is a full pill" (s1.radius >= 13))
        }
        ; a row the colour of its card is not painted over the card's corners
        def rows:int 0
        def at:int (indexOf doc.json "erazer-listitem")
        while (at >= 0) {
            def line:string (substring doc.json at (at + 200))
            def end:int (indexOf line "}")
            if (end > 0) {
                line = (substring line 0 end)
            }
            if ((indexOf line "background-color") >= 0) {
                rows = (rows + 1)
            }
            def rest:string (substring doc.json (at + 10) (strlen doc.json))
            def nx:int (indexOf rest "erazer-listitem")
            if (nx >= 0) {
                at = ((at + 10) + nx)
            } {
                at = (0 - 1)
            }
        }
        t.eqInt("rows leave the card's fill to the card" rows 0)
    }

    ; A tall single mark far above the page's text size, or ink as light
    ; as its background, is not text; inside a switch it is the knob's
    ; shadow and goes.
    fn testTextDoubt:void (t:RgTest) {
        def img:ImageBuffer (ErazerPaint.groupedList())
        ; a knob shadow: a grey disc offset down-left, the white knob over it,
        ; leaving a crescent on the green track
        ErazerFont.fillRoundRect(img 300 51 26 26 13 150 170 160)
        ErazerFont.fillRoundRect(img 304 49 26 26 13 255 255 255)
        def doc:ErazerDoc (Erazer.analyze(img))
        def root:ErazerNode (unwrap doc.root)
        t.eqInt("six switches still" (root.roleCount("switch")) 6)
        t.eqInt("no text inside a switch" (this.textInSwitch(root false)) 0)
    }

    fn textInSwitch:int (n:ErazerNode inside:boolean) {
        def c:int 0
        if (inside && ((n.role == "text") || (n.role == "label"))) {
            c = 1
        }
        def deeper:boolean (inside || (n.role == "switch"))
        def i:int 0
        while (i < (array_length n.kids)) {
            def k:ErazerNode (itemAt n.kids i)
            c = (c + (this.textInSwitch(k deeper)))
            i = (i + 1)
        }
        return c
    }

